# .htaccess - Redirect for book page
# Redirect /mon-infini-est-bleu permanently to /magazine (301)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} ^/mon-infini-est-bleu/?$ [NC]
  RewriteRule ^.*$ /magazine [R=301,L]
</IfModule>

# Fallback simple Redirect (if mod_rewrite not enabled)
Redirect 301 /mon-infini-est-bleu /magazine
	# 1. Déclaration globale et sécurisée de votre clé NeverBounce
SetEnv NEVERBOUNCE_API_KEY private_c9c633a334118578ad8edf96844f5ff4

# 2. Gestion des index
DirectoryIndex index.html index.php

# 3. Autoriser spécifiquement votre script de vérification
<Files "verify.php">
    Order allow,deny
    Allow from all
</Files>

# 4. Règle optionnelle pour Astro Statique : Rediriger proprement les jolies URLs (ex: /contact au lieu de /contact.html)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Si le fichier demandé n'existe pas (ex: /about), on cherche si /about.html existe
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>