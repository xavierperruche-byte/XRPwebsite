---
// src/pages/success.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Paiement réussi - We The Agency" currentPage="checkout-success">
  <div class="success-page">
    <div class="success-container">
      <div class="success-icon-wrapper">
        <svg class="success-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>

      <h1>Paiement réussi !</h1>
      <p class="success-message">
        Merci pour votre commande. Vous allez recevoir un email de confirmation dans quelques instants.
      </p>

      <div class="order-details" id="orderDetails">
        <h2>Détails de votre commande</h2>
        <div id="orderInfo"></div>
      </div>

      <div class="success-actions">
        <a href="/catalog" class="btn-primary">
          Continuer vos achats
        </a>
        <a href="/" class="btn-secondary">
          Retour à l'accueil
        </a>
      </div>

      <div class="next-steps">
        <h3>Prochaines étapes</h3>
        <ul>
          <li>
            <svg class="step-icon" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
            </svg>
            <div>
              <strong>Email de confirmation</strong>
              <p>Vous recevrez un email avec tous les détails de votre commande</p>
            </div>
          </li>
          <li>
            <svg class="step-icon" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <div>
              <strong>Accès immédiat</strong>
              <p>Votre adhésion est maintenant active</p>
            </div>
          </li>
          <li>
            <svg class="step-icon" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 5a2 2 0 012-2h7a2 2 0 012 2v4a2 2 0 01-2 2H9l-3 3v-3H4a2 2 0 01-2-2V5z"></path>
              <path d="M15 7v2a4 4 0 01-4 4H9.828l-1.766 1.767c.28.149.599.233.938.233h2l3 3v-3h2a2 2 0 002-2V9a2 2 0 00-2-2h-1z"></path>
            </svg>
            <div>
              <strong>Support disponible</strong>
              <p>Notre équipe est là pour vous accompagner</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="help-section">
        <p>Une question sur votre commande ?</p>
        <a href="/contact">Contactez notre service client</a>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Récupérer les informations de la commande
  const urlParams = new URLSearchParams(window.location.search);
  const checkoutId = urlParams.get('checkout_id');
  const orderReference = urlParams.get('ref');

  if (checkoutId || orderReference) {
    const orderInfo = document.getElementById('orderInfo');
    if (orderInfo) {
      orderInfo.innerHTML = `
        <div class="info-row">
          <span class="info-label">Numéro de commande:</span>
          <span class="info-value">${orderReference || checkoutId}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Date:</span>
          <span class="info-value">${new Date().toLocaleDateString('fr-FR')}</span>
        </div>
      `;
    }
  }

  // Vider le panier
  localStorage.removeItem('cart');
  window.dispatchEvent(new CustomEvent('cartUpdated', { 
    detail: { itemCount: 0 } 
  }));

  // Animation d'entrée
  document.addEventListener('DOMContentLoaded', () => {
    const successPage = document.querySelector('.success-page');
    if (successPage) {
      successPage.classList.add('animate-in');
    }
  });
</script>

<style>
  .success-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    background: linear-gradient(135deg, #f7fafc 0%, #e2e8f0 100%);
    opacity: 0;
    animation: fadeIn 0.6s ease-out forwards;
  }

  @keyframes fadeIn {
    to { opacity: 1; }
  }

  .success-container {
    max-width: 700px;
    width: 100%;
    background: white;
    border-radius: 20px;
    padding: 3rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
    text-align: center;
    animation: slideUp 0.8s ease-out;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .success-icon-wrapper {
    width: 100px;
    height: 100px;
    margin: 0 auto 2rem;
    background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: scaleIn 0.5s ease-out 0.3s both;
  }

  @keyframes scaleIn {
    from {
      transform: scale(0);
    }
    to {
      transform: scale(1);
    }
  }

  .success-icon {
    width: 60px;
    height: 60px;
    color: white;
    stroke-width: 3;
  }

  h1 {
    font-size: 2.5rem;
    color: #2d3748;
    margin: 0 0 1rem 0;
  }

  .success-message {
    font-size: 1.2rem;
    color: #718096;
    margin-bottom: 3rem;
    line-height: 1.6;
  }

  .order-details {
    margin: 3rem 0;
    padding: 2rem;
    background: #f7fafc;
    border-radius: 15px;
    text-align: left;
  }

  .order-details h2 {
    font-size: 1.3rem;
    color: #2d3748;
    margin: 0 0 1.5rem 0;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 1px solid #e2e8f0;
  }

  .info-row:last-child {
    border-bottom: none;
  }

  .info-label {
    color: #718096;
  }

  .info-value {
    font-weight: 600;
    color: #2d3748;
  }

  .success-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin: 3rem 0;
  }

  .btn-primary,
  .btn-secondary {
    padding: 1rem 2rem;
    border-radius: 10px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
    font-size: 1rem;
  }

  .btn-primary {
    background: linear-gradient(135deg, #686f8d 0%, #fff0ea 100%);
    color: white;
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(104, 111, 141, 0.3);
  }

  .btn-secondary {
    background: white;
    color: #686f8d;
    border: 2px solid #686f8d;
  }

  .btn-secondary:hover {
    background: #686f8d;
    color: white;
  }

  .next-steps {
    margin: 3rem 0;
    text-align: left;
  }

  .next-steps h3 {
    font-size: 1.3rem;
    color: #2d3748;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .next-steps ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .next-steps li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .step-icon {
    width: 40px;
    height: 40px;
    color: #48bb78;
    flex-shrink: 0;
  }

  .next-steps li div {
    flex: 1;
  }

  .next-steps strong {
    display: block;
    color: #2d3748;
    margin-bottom: 0.25rem;
  }

  .next-steps p {
    margin: 0;
    color: #718096;
    font-size: 0.95rem;
  }

  .help-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid #e2e8f0;
  }

  .help-section p {
    margin: 0 0 1rem 0;
    color: #718096;
  }

  .help-section a {
    color: #686f8d;
    font-weight: 600;
    text-decoration: none;
    font-size: 1.1rem;
  }

  .help-section a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .success-container {
      padding: 2rem;
    }

    h1 {
      font-size: 2rem;
    }

    .success-actions {
      flex-direction: column;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>