---
import Layout from '../../layouts/Layout.astro';
import Login from '../../components/loginComponent.astro';

const defaultPrompts = {
  chasseur: {
    role: "Chasseur Immobilier de Luxe - Morbihan",
    goal: "Dénicher des maisons (>1.6M€, 180m2) ou terrains (>800k€) d'exception à Baden (+20km)",
    backstory: "Expert local du Golfe du Morbihan, tu connais les secteurs de Baden, Arradon, Le Bono, La Trinité sur Mer et Larmor-Baden."
  },
  expert: {
    role: "Consultant en Architecture",
    goal: "Valider la vue, le calme et la proximité des bus pour Vannes/Auray. Indique le nom de l'agence et l'URL.",
    backstory: "Tu analyses la valeur et la logistique (transports Kicéo/BreizhGo) des biens trouvés."
  }
};

const agentStats = {
  status: 'ready',
  lastRun: '0 heures',
  totalRuns: 1,
  successRate: 100
};
---
<Login />

<Layout title="Robot_0001 - Expert Immo Luxe">

  <div class="robot-page">
    <!-- Breadcrumb & Header -->
    <p><br><br><br></p>
    <div class="page-header">
      <a href="/ai" class="breadcrumb">← AI Station</a>
      <div class="header-row">
        <div class="header-left">
          <div class="agent-badge">
            <span class="badge-icon">🤖</span>
            <span>AGENT_Robot_0001</span>
          </div>
          <h1>Expert Immo Luxe</h1>
          <p class="subtitle">Spécialiste du marché de prestige dans le Morbihan</p>
        </div>
        <div class="status-card">
          <span class="status-dot active"></span>
          <span class="status-text">Système Prêt</span>
        </div>
      </div>
    </div>

    <!-- Stats rapides -->

    <div class="quick-stats">
      <div class="stat-mini">
        <div id="stat-totalRuns" class="stat-mini-value">0</div>
        <div class="stat-mini-label">Exécutions</div>
      </div>
      <div class="stat-mini">
        <div id="stat-successRate" class="stat-mini-value">100%</div>
        <div class="stat-mini-label">Taux de succès</div>
      </div>
      <div class="stat-mini">
        <div id="stat-lastRun" class="stat-mini-value">--:--</div>
        <div class="stat-mini-label">Dernière exec.</div>
      </div>
    </div>

    <!-- Grille principale -->
    <div class="main-grid">
      <!-- Colonne gauche : Configuration -->
      <div class="config-column">
        <div class="section-card">
          <h2 class="card-title">Configuration des Agents</h2>
          
          <form id="agent-form" class="agent-form">
            <!-- Agent Chasseur -->
            <div class="agent-config">
              <div class="agent-header">
                <span class="agent-label">Agent : Chasseur de Prestige</span>
                <span class="agent-role-badge">Recherche</span>
              </div>
              
              <div class="form-group">
                <label>Objectif</label>
                <textarea 
                  name="chasseur_goal" 
                  rows="3"
                  placeholder="Définissez l'objectif de l'agent..."
                >{defaultPrompts.chasseur.goal}</textarea>
              </div>

              <div class="form-group">
                <label>Contexte</label>
                <textarea 
                  name="chasseur_backstory" 
                  rows="3"
                  class="backstory-field"
                >{defaultPrompts.chasseur.backstory}</textarea>
              </div>
            </div>

            <!-- Agent Expert -->
            <div class="agent-config">
              <div class="agent-header">
                <span class="agent-label">Agent : Expert Urbanisme</span>
                <span class="agent-role-badge">Validation</span>
              </div>
              
              <div class="form-group">
                <label>Objectif</label>
                <textarea 
                  name="expert_goal" 
                  rows="3"
                >{defaultPrompts.expert.goal}</textarea>
              </div>

              <div class="form-group">
                <label>Contexte</label>
                <textarea 
                  name="expert_backstory" 
                  rows="3"
                  class="backstory-field"
                >{defaultPrompts.expert.backstory}</textarea>
              </div>
            </div>

            <!-- Bouton d'exécution -->
            <button type="submit" id="run-button" class="run-btn">
              <svg id="loading-spinner" class="spinner hidden" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span id="button-text">▶ Exécuter la recherche</span>
            </button>
          </form>
        </div>
      </div>

      <!-- Colonne droite : Console -->
      <div class="console-column">
        <div class="console-card">
          <div class="console-header">
            <span class="console-title">Output Console</span>
            <div class="console-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
          
          <div id="result-display" class="console-output">
            <div class="console-empty">
              <svg class="empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              <p>En attente d'exécution...</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>


<script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script is:inline>
  // --- 1. GESTION DES STATISTIQUES (LocalStorage) ---
  const statsKey = 'robot001_stats_v1';
  
  // Fonction pour charger et afficher les stats au démarrage
  function initStats() {
    const saved = localStorage.getItem(statsKey);
    const stats = saved ? JSON.parse(saved) : { totalRuns: 0, successCount: 0, lastRun: '--:--' };
    
    const rate = stats.totalRuns > 0 ? Math.round((stats.successCount / stats.totalRuns) * 100) : 100;
    
    // Mise à jour visuelle sécurisée
    if(document.getElementById('stat-totalRuns')) document.getElementById('stat-totalRuns').textContent = stats.totalRuns;
    if(document.getElementById('stat-successRate')) document.getElementById('stat-successRate').textContent = rate + '%';
    if(document.getElementById('stat-lastRun')) document.getElementById('stat-lastRun').textContent = stats.lastRun;
    
    return stats;
  }

  // Fonction pour sauvegarder après un essai
  function saveExecution(isSuccess) {
    const stats = JSON.parse(localStorage.getItem(statsKey)) || { totalRuns: 0, successCount: 0, lastRun: '--:--' };
    
    stats.totalRuns += 1;
    if (isSuccess) stats.successCount += 1;
    stats.lastRun = new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
    
    localStorage.setItem(statsKey, JSON.stringify(stats));
    initStats(); // Rafraîchir l'affichage
  }

  // --- 2. LOGIQUE PRINCIPALE ---
  document.addEventListener('DOMContentLoaded', () => {
    initStats(); // Charger les stats au chargement de la page

    const form = document.getElementById('agent-form');
    const runButton = document.getElementById('run-button');
    const buttonText = document.getElementById('button-text');
    const spinner = document.getElementById('loading-spinner');
    const resultDisplay = document.getElementById('result-display');

    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // État de chargement
      runButton.disabled = true;
      if(buttonText) buttonText.textContent = "IA en cours de réflexion...";
      if(spinner) spinner.classList.remove('hidden');
      
      resultDisplay.innerHTML = `<div class="loading-state" style="padding: 40px; text-align: center;">⏳ Analyse en cours...</div>`;

      try {
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        // Construction du prompt combiné pour le serveur Docker Robot002
        const fullPrompt = `OBJECTIF: ${payload.chasseur_goal}\nCONTEXTE: ${payload.chasseur_backstory}\n---\nVALIDATION: ${payload.expert_goal}`;

        // APPEL API (Format Docker/FastAPI)
        const response = await fetch('https://xperruche-robot002.hf.space/run/predict', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ data: [fullPrompt] })
        });

        if (!response.ok) throw new Error(`Erreur serveur (${response.status})`);

        const json = await response.json();

        // On vérifie la structure de réponse du serveur Docker
        if (json.data && json.data[0]) {
          const report = json.data[0];
          
          // Mise à jour de l'affichage avec Marked pour le Markdown
          resultDisplay.innerHTML = `
            <div class="report-container animate-fade-in">
              <div style="display:flex; justify-content:space-between; margin-bottom:20px; font-size:10px; color:#10b981; font-weight:bold;">
                <span>✓ RAPPORT GÉNÉRÉ</span>
                <span style="color:#9ca3af;">${new Date().toLocaleTimeString()}</span>
              </div>
              <div class="markdown-body">${marked.parse(report)}</div>
            </div>
          `;
          
          saveExecution(true); // ✅ STATS SUCCÈS
        } else {
          throw new Error('Réponse vide du moteur IA');
        }

      } catch (error) {
        console.error('Erreur:', error);
        resultDisplay.innerHTML = `<p style="color:red; padding:20px;">❌ Erreur: ${error.message}</p>`;
        
        saveExecution(false); // ❌ STATS ÉCHEC
      } finally {
        runButton.disabled = false;
        if(buttonText) buttonText.textContent = "▶ Exécuter la recherche";
        if(spinner) spinner.classList.add('hidden');
      }
    });
  });
</script>

<script is:inline>
  const form = document.getElementById('agent-form');
  const runButton = document.getElementById('run-button');
  const buttonText = document.getElementById('button-text');
  const spinner = document.getElementById('loading-spinner');
  const resultDisplay = document.getElementById('result-display');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // 1. État de chargement
    runButton.disabled = true;
    buttonText.textContent = "IA en cours de réflexion...";
    spinner.classList.remove('hidden');
    
    resultDisplay.innerHTML = `
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; text-align: center; gap: 20px;">
        <div style="width: 40px; height: 40px; border: 4px solid #f3f3f3; border-top: 4px solid #4f46e5; border-radius: 50%; animation: spin 1s linear infinite;"></div>
        <p style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: #6b7280;">Recherche en cours dans le Morbihan...</p>
        <p style="font-size: 10px; color: #9ca3af;">Les agents analysent les données en temps réel</p>
      </div>
    `;

    try {
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      console.log('📤 Envoi vers HuggingFace:', payload);

      const response = await fetch('https://xperruche-robot001.hf.space/run', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      console.log('📥 Réponse reçue:', response.status);

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
      }

      const data = await response.json();
      console.log('✅ Data:', data);

      if (data.result) {
        const timestamp = new Date().toLocaleTimeString();
        
        // Injection du HTML retourné par Python
        resultDisplay.innerHTML = `
          <div class="animate-fade-in">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e5e7eb; padding-bottom: 16px; margin-bottom: 24px;">
              <span style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.15em; font-weight: 700; color: #10b981;">✓ Rapport Expert Généré</span>
              <span style="font-size: 10px; color: #9ca3af; font-family: monospace;">${timestamp}</span>
            </div>
            <div class="report-content">
              ${data.result}
            </div>
          </div>
        `;      
        } 
        else {
        throw new Error('Aucun résultat dans la réponse');
      }

    } catch (error) {
      console.error('❌ Erreur:', error);
      
      resultDisplay.innerHTML = `
        <div style="padding: 40px; text-align: center; color: #dc2626;">
          <svg style="width: 48px; height: 48px; margin: 0 auto 16px;" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
          <p style="font-weight: 700; margin-bottom: 8px;">Erreur lors de l'exécution</p>
          <p style="font-size: 14px; color: #6b7280;">${error.message}</p>
          <p style="font-size: 12px; color: #9ca3af; margin-top: 16px;">Vérifiez que le service HuggingFace est bien en ligne.</p>
        </div>
      `;
    } finally {
      // 2. Réinitialiser le bouton
      runButton.disabled = false;
      buttonText.textContent = "▶ Exécuter la recherche";
      spinner.classList.add('hidden');
    }
  });
 
</script>

<style>
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .spinner {
    width: 16px;
    height: 16px;
    animation: spin 1s linear infinite;
  }

  .spinner.hidden {
    display: none;
  }

  .animate-fade-in {
    animation: fadeIn 0.5s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<style is:global>
  /* === GLOBAL RESET & BLINDAGE === */
  :root {
    --color-wta-dark: #111827; /* Noir Weopup */
    --color-wta-gray-light: #fafafa;
    --color-wta-gray-medium: #6b7280;
    --color-wta-accent: #4f46e5; /* Violet stats */
    --color-border: #e5e7eb;
    --font-family-main: 'Inter', sans-serif; /* Assure-toi que Inter est chargée */
  }

  body {
    margin: 0;
    padding: 0;
    background-color: var(--color-wta-gray-light);
    font-family: var(--font-family-main);
    color: #333;
  }

  /* Force le box-sizing pour tous les éléments pour éviter les débordements */
  *, *::before, *::after {
    box-sizing: border-box;
  }


/* Réduction de la police et du poids */
.report-content {
  font-size: 13px !important; /* Plus petit (était 14px) */
  line-height: 1.7;
  color: #4b5563; /* Gris plus doux */
  text-align: left;
  white-space: normal;
  font-weight: 400; /* Normal, pas gras */
}

/* Titres moins gras et plus petits */
.report-content h1, 
.report-content h2, 
.report-content h3 {
  color: #111827;
  font-weight: 600 !important; /* Moins gras (était 700) */
  margin-top: 1.5em;
  margin-bottom: 0.5em;
  display: block;
}

.report-content h1 { 
  font-size: 1.25rem !important; /* Plus petit (était 1.5rem) */
  border-bottom: 1px solid #e5e7eb; 
  padding-bottom: 10px; 
}

.report-content h2 { 
  font-size: 1.1rem !important; /* Plus petit (était 1.25rem) */
}

.report-content h3 { 
  font-size: 1rem !important; /* Plus petit (était 1.1rem) */
}

/* Paragraphes */
.report-content p { 
  margin-bottom: 0.8rem;
  font-weight: 400; /* Normal */
}

/* Listes */
.report-content ul, 
.report-content ol {
  margin-bottom: 0.8rem;
  padding-left: 1.5rem;
  list-style-type: disc;
  font-weight: 400; /* Normal */
}

.report-content li {
  margin-bottom: 0.4rem;
  font-weight: 400; /* Normal */
}

/* Strong/Bold moins prononcé */
.report-content strong { 
  font-weight: 600 !important; /* Moins gras (était 700) */
  color: #1f2937; /* Gris foncé au lieu de noir */
}

/* === LIENS CLIQUABLES === */
.report-content a {
  color: #4f46e5 !important;
  text-decoration: underline !important;
  font-weight: 500;
  transition: all 0.2s ease;
  cursor: pointer !important;
  display: inline !important; /* Important pour que le lien reste inline */
}

.report-content a:hover {
  color: #4338ca !important;
  text-decoration: none !important;
}

.report-content a:visited {
  color: #7c3aed !important;
}

/* Force les liens à être cliquables même s'ils sont dans d'autres éléments */
.report-content p a,
.report-content li a,
.report-content div a {
  pointer-events: auto !important;
  cursor: pointer !important;
}

/* Console link (si vous utilisez cette classe) */
.console-link {
  color: #4f46e5 !important;
  text-decoration: underline !important;
  font-weight: 500;
  transition: opacity 0.2s;
  cursor: pointer !important;
}

.console-link:hover { 
  opacity: 0.8; 
}
</style>

