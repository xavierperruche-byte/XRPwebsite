---
import Layout from '../../layouts/Layout.astro';
import Login from '../../components/loginComponent.astro';

const defaultPrompts = {
  chasseur: {
    role: "Chasseur Immobilier de Luxe - Morbihan",
    goal: "Dénicher des maisons (>1.6M€, 180m2) ou terrains (>800k€) d'exception à Baden (+20km)",
    backstory: "Expert local du Golfe du Morbihan, tu connais les secteurs de Baden, Arradon, Le Bono, La Trinité sur Mer et Larmor-Baden."
  },
  expert: {
    role: "Consultant en Architecture",
    goal: "Valider la vue, le calme et la proximité des bus pour Vannes/Auray. Indique le nom de l'agence et l'URL.",
    backstory: "Tu analyses la valeur et la logistique (transports Kicéo/BreizhGo) des biens trouvés."
  }
};

const agentStats = {
  status: 'ready',
  lastRun: '2 heures',
  totalRuns: 47,
  successRate: 94
};
---
<Login client:load />


<Layout title="Robot_0001 - Expert Immo Luxe">

  <div class="robot-page">
    <!-- Breadcrumb & Header -->
    <p><br><br><br></p>
    <div class="page-header">
      <a href="/ai" class="breadcrumb">← AI Station</a>
      <div class="header-row">
        <div class="header-left">
          <div class="agent-badge">
            <span class="badge-icon">🤖</span>
            <span>AGENT_Robot_0001</span>
          </div>
          <h1>Expert Immo Luxe</h1>
          <p class="subtitle">Spécialiste du marché de prestige dans le Morbihan</p>
        </div>
        <div class="status-card">
          <span class="status-dot active"></span>
          <span class="status-text">Système Prêt</span>
        </div>
      </div>
    </div>

    <!-- Stats rapides -->
    <div class="quick-stats">
      <div class="stat-mini">
        <div class="stat-mini-value">{agentStats.totalRuns}</div>
        <div class="stat-mini-label">Exécutions</div>
      </div>
      <div class="stat-mini">
        <div class="stat-mini-value">{agentStats.successRate}%</div>
        <div class="stat-mini-label">Taux de succès</div>
      </div>
      <div class="stat-mini">
        <div class="stat-mini-value">{agentStats.lastRun}</div>
        <div class="stat-mini-label">Dernière exec.</div>
      </div>
    </div>

    <!-- Grille principale -->
    <div class="main-grid">
      <!-- Colonne gauche : Configuration -->
      <div class="config-column">
        <div class="section-card">
          <h2 class="card-title">Configuration des Agents</h2>
          
          <form id="agent-form" class="agent-form">
            <!-- Agent Chasseur -->
            <div class="agent-config">
              <div class="agent-header">
                <span class="agent-label">Agent : Chasseur de Prestige</span>
                <span class="agent-role-badge">Recherche</span>
              </div>
              
              <div class="form-group">
                <label>Objectif</label>
                <textarea 
                  name="chasseur_goal" 
                  rows="3"
                  placeholder="Définissez l'objectif de l'agent..."
                >{defaultPrompts.chasseur.goal}</textarea>
              </div>

              <div class="form-group">
                <label>Contexte</label>
                <textarea 
                  name="chasseur_backstory" 
                  rows="3"
                  class="backstory-field"
                >{defaultPrompts.chasseur.backstory}</textarea>
              </div>
            </div>

            <!-- Agent Expert -->
            <div class="agent-config">
              <div class="agent-header">
                <span class="agent-label">Agent : Expert Urbanisme</span>
                <span class="agent-role-badge">Validation</span>
              </div>
              
              <div class="form-group">
                <label>Objectif</label>
                <textarea 
                  name="expert_goal" 
                  rows="3"
                >{defaultPrompts.expert.goal}</textarea>
              </div>

              <div class="form-group">
                <label>Contexte</label>
                <textarea 
                  name="expert_backstory" 
                  rows="3"
                  class="backstory-field"
                >{defaultPrompts.expert.backstory}</textarea>
              </div>
            </div>

            <!-- Bouton d'exécution -->
            <button type="submit" id="run-button" class="run-btn">
              <svg id="loading-spinner" class="spinner hidden" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span id="button-text">▶ Exécuter la recherche</span>
            </button>
          </form>
        </div>
      </div>

      <!-- Colonne droite : Console -->
      <div class="console-column">
        <div class="console-card">
          <div class="console-header">
            <span class="console-title">Output Console</span>
            <div class="console-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
          
          <div id="result-display" class="console-output">
            <div class="console-empty">
              <svg class="empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              <p>En attente d'exécution...</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>


<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
  // On récupère les éléments
  const form = document.getElementById('agent-form') as HTMLFormElement;
  const runButton = document.getElementById('run-button') as HTMLButtonElement;
  const buttonText = document.getElementById('button-text') as HTMLElement;
  const spinner = document.getElementById('loading-spinner') as HTMLElement;
  const resultDisplay = document.getElementById('result-display') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // 1. État de chargement UI
    runButton.disabled = true;
    runButton.classList.add('opacity-50', 'cursor-not-allowed');
    buttonText.textContent = "IA en cours de réflexion...";
    spinner.classList.remove('hidden');
    
    resultDisplay.innerHTML = `
      <div class="flex flex-col items-center justify-center py-20 text-center space-y-4">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-black"></div>
        <p class="text-xs uppercase tracking-[0.2em] font-medium">Recherche en cours dans le Morbihan...</p>
        <p class="text-[10px] text-gray-400 italic">Le Chasseur et l'Expert analysent les données en temps réel.</p>
      </div>
    `;

    try {
      // 2. Récupération des données du formulaire
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      // 3. APPEL RÉEL À TON API RENDER
        // Dans robot001.astro
        const response = await fetch('https://xperruche-robot001.hf.space/run', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

      if (!response.ok) throw new Error('Erreur serveur lors de l\'exécution');

      const data = await response.json();

      // 4. AFFICHAGE DES RÉSULTATS RÉELS
      if (data.result) {
        // @ts-ignore - On utilise marked pour transformer le Markdown de Python en HTML
        const htmlContent = window.marked.parse(data.result);

        resultDisplay.innerHTML = `
          <div class="animate-fade-in space-y-6">
            <div class="flex justify-between items-center border-b border-gray-100 pb-4">
              <span class="text-[10px] uppercase tracking-widest font-bold text-green-600">✓ Rapport Final Généré</span>
              <span class="text-[10px] text-gray-400 font-mono">${new Date().toLocaleTimeString()}</span>
            </div>
            
            <div class="prose prose-sm max-w-none prose-headings:font-light prose-a:text-black prose-a:font-bold prose-a:underline font-light leading-relaxed text-gray-700">
              ${htmlContent}
            </div>

            <div class="mt-8 pt-6 border-t border-gray-100">
               <button onclick="window.print()" class="text-[9px] uppercase tracking-widest text-gray-400 hover:text-black transition-colors">
                 ⎙ Imprimer le rapport expert
               </button>
            </div>
          </div>
        `;
      }

    } catch (error) {
      console.error(error);
      resultDisplay.innerHTML = `
        <div class="p-6 border border-red-100 bg-red-50 text-red-700 rounded-sm">
          <p class="text-xs font-bold uppercase tracking-widest mb-2">Erreur Système</p>
          <p class="text-sm font-light">${error.message}</p>
          <p class="mt-4 text-[10px] opacity-70">Connexion établie avec Render. Vérifiez les logs si le problème persiste.</p>
        </div>
      `;
    } finally {
      // 5. Rétablir le bouton
      runButton.disabled = false;
      runButton.classList.remove('opacity-50', 'cursor-not-allowed');
      buttonText.textContent = "Relancer la mission";
      spinner.classList.add('hidden');
    }
  });

// Dans ton <script> de robot001.astro
function displayResult(text) {
  const container = document.getElementById('result-display');
  if (!container) return;

  // Expression régulière pour détecter les URL et les rendre cliquables
  const urlRegex = /(https?:\/\/[^\s]+)/g;
  const formattedText = text.replace(urlRegex, (url) => {
    return `<a href="${url}" target="_blank" rel="noopener noreferrer" class="console-link">Voir l'annonce →</a>`;
  });

  // On utilise innerHTML pour que les balises <a> soient interprétées
  container.innerHTML = `<div class="result-content">${formattedText}</div>`;
}

</script>

<style is:global>
  /* === GLOBAL RESET & BLINDAGE === */
  :root {
    --color-wta-dark: #111827; /* Noir Weopup */
    --color-wta-gray-light: #fafafa;
    --color-wta-gray-medium: #6b7280;
    --color-wta-accent: #4f46e5; /* Violet stats */
    --color-border: #e5e7eb;
    --font-family-main: 'Inter', sans-serif; /* Assure-toi que Inter est chargée */
  }

  body {
    margin: 0;
    padding: 0;
    background-color: var(--color-wta-gray-light);
    font-family: var(--font-family-main);
    color: #333;
  }

  /* Force le box-sizing pour tous les éléments pour éviter les débordements */
  *, *::before, *::after {
    box-sizing: border-box;
  }
</style>

<style>
  /* === LAYOUT CONTEUR === */
  .robot-page {
    max-width: 1600px; /* Largeur max soignée */
    margin: 0 auto; /* CENTRE LE CONTEUR PRINCIPAL */
    padding: 40px 10px 80px; /* Padding généreux */
  }

  /* === BREADCRUMB === */
  .breadcrumb {
    display: inline-block;
    font-size: 11px;
    color: #a1a7b3;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 24px;
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb:hover {
    color: var(--color-wta-dark);
  }

  /* === EN-TÊTE DE LA PAGE === */
  .page-header {
    margin-bottom: 40px;
    position: relative;
  }

  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start; /* Aligne le badge au top du titre */
    gap: 24px;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .agent-badge-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fdfdfd;
    border: 1px solid #eee;
    padding: 8px 16px;
    border-radius: 99px;
    margin-bottom: 16px;
  }

  .agent-emoji {
    font-size: 18px;
  }

  .agent-id {
    font-size: 11px;
    font-weight: 700;
    font-family: monospace; /* Type code */
    color: var(--color-wta-dark);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .page-header h1 {
    font-size: 38px;
    font-weight: 800;
    color: var(--color-wta-dark);
    letter-spacing: -0.04em;
    margin: 0 0 10px 0;
  }

  .subtitle {
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-wta-gray-medium);
    font-weight: 300;
    margin: 0;
    max-width: 480px;
  }

  .status-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    padding: 10px 18px;
    border-radius: 99px;
    white-space: nowrap; /* Évite de couper le texte */
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
  }

  .status-dot.active {
    animation: pulse 2.5s infinite;
  }

  .status-text {
    font-size: 12px;
    font-weight: 700;
    color: #065f46;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* === STATS RAPIDES === */
  .quick-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr); /* 3 colonnes égales */
    gap: 16px;
    margin-bottom: 40px;
  }

  .stat-mini {
    background: white;
    border: 1px solid var(--color-border);
    padding: 24px;
    border-radius: 16px;
    text-align: center;
    transition: box-shadow 0.3s ease;
  }

  .stat-mini:hover {
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
  }

  .stat-mini-value {
    font-size: 32px;
    font-weight: 800;
    color: var(--color-wta-accent);
    margin-bottom: 6px;
  }

  .stat-mini-label {
    font-size: 11px;
    color: var(--color-wta-gray-medium);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
  }

  /* === GRILLE PRINCIPALE === */
  .main-grid {
    display: grid;
    grid-template-columns: 1fr 1fr; /* 2 colonnes égales */
    gap: 24px;
  }

  /* === COLONNE GAUCHE : CONFIGURATION === */
  .config-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .section-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 32px; /* Padding généreux */
  }

  .card-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-wta-dark);
    margin: 0 0 32px 0;
  }

  .agent-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .agent-config {
    padding: 24px;
    background: #fafafa;
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .agent-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .agent-label {
    font-size: 12px;
    font-weight: 700;
    color: #374151;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .agent-role-badge {
    background: #dbeafe;
    color: #1e40af;
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .form-group {
    margin-bottom: 16px;
  }

  .form-group label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    color: var(--color-wta-gray-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .form-group textarea {
    width: 100%; /* Prend toute la largeur dispo */
    padding: 14px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 13px;
    color: var(--color-wta-dark);
    background: white;
    line-height: 1.6;
    transition: border-color 0.2s, box-shadow 0.2s;
    font-family: inherit; /* Utilise Inter */
  }

  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-wta-dark);
    box-shadow: 0 0 0 3px rgba(17, 24, 39, 0.05);
  }

  .backstory-field {
    font-style: italic;
    color: var(--color-wta-gray-medium) !important;
    font-size: 12px !important;
    background: #fdfdfd !important;
  }

  .run-btn {
    /* Centrage et Taille compacte */
    display: flex;
    margin: 24px auto 0; 
    width: fit-content;
    padding: 10px 24px; /* Plus fin en hauteur */
    
    /* Style Épuré */
    background: var(--color-wta-dark);
    color: white;
    border: 1px solid var(--color-wta-dark);
    border-radius: 8px; /* Carré légèrement arrondi, plus "Pro/Tech" que la pilule */
    
    /* Typographie ultra-fine */
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em; /* Très espacé pour le côté Premium */
    
    cursor: pointer;
    transition: all 0.2s ease;
    align-items: center;
    gap: 10px;
  }

  .run-btn:hover:not(:disabled) {
    background: transparent;
    color: var(--color-wta-dark);
    /* Effet d'inversion élégant au survol */
  }

  .run-btn:active {
    transform: scale(0.97);
  }

  .run-btn:disabled {
    opacity: 0.3;
    filter: grayscale(1);
    cursor: not-allowed;
  }

  /* Petite icône discrète */
  .btn-icon {
    font-size: 10px;
    opacity: 0.8;
  }

  /* === COLONNE DROITE : CONSOLE === */
  .console-column {
    display: flex;
  }

  .console-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    overflow: hidden;
    width: 100%; /* Prend toute la largeur dispo de sa colonne */
    height: fit-content;
    min-height: 600px;
    display: flex;
    flex-direction: column;
  }

  .console-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    background: #fafafa;
    border-bottom: 1px solid var(--color-border);
  }

  .console-title {
    font-size: 11px;
    font-weight: 700;
    color: #374151;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .console-dots {
    display: flex;
    gap: 6px;
  }

  .console-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d1d5db;
  }

  .console-output {
    flex: 1;
    padding: 32px;
    overflow-y: auto;
    font-size: 14px;
    color: #374151;
    line-height: 1.7;
    background: #ffffff;
    white-space: pre-wrap; /* LE SECRET : Respecte les sauts de ligne et revient à la ligne si c'est trop long */
    word-break: break-word; /* Évite que les longues URLs ne cassent la mise en page */
    line-height: 1.6;      /* Aère le texte pour le confort de lecture */
  }

  .console-output::-webkit-scrollbar {
    width: 6px;
  }

  .console-output::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 3px;
  }

  .console-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #a1a7b3;
    text-align: center;
  }

  .empty-icon {
    width: 56px;
    height: 56px;
    margin-bottom: 20px;
    opacity: 0.4;
  }

  .console-empty p {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  /* === ANIMATIONS === */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .fade-in-up {
    animation: fadeInUp 0.4s ease-out forwards;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  /* === RESPONSIVE (Blindage Mobile/Tablette) === */
  @media (max-width: 1024px) {
    .quick-stats {
      grid-template-columns: 1fr; /* Stats en colonne */
    }
    
    .main-grid {
      grid-template-columns: 1fr; /* Grille en colonne */
    }
    
    .console-card {
      min-height: 400px;
    }
  }

  @media (max-width: 768px) {
    .robot-page {
      padding: 24px 16px;
    }

    .page-header h1 {
      font-size: 28px;
    }
    
    .status-badge {
      padding: 8px 14px;
    }
  }
</style>
