---
// src/pages/ai/index.astro
import Layout from '../../layouts/Layout.astro';

const stats = {
  agentsActifs: 1,
  uptimeMoyen: 99.8,
  requetes24h: 2.4
};

const apiServices = [
  { name: 'GOOGLE_API_KEY Google Search', status: 'Online', type: 'Recherche sémantique avancée' },
  { name: 'TAVILY_API_KEY Tavily API', status: 'Online', type: 'Extraction de données en temps réel' },
  { name: 'GITHUB_TOKEN GitHub Models', status: 'Online', type: 'Accès aux modèles d\'IA' },
  { name: 'GROQ_API_KEY Groq Cloud', status: 'Online', type: 'Inférence ultra-rapide' },
];

const activeAgents = [
  {
    name: 'Expert Immo Luxe',
    core: 'AGENT_Robot_0001',
    status: 'active',
    specialite: 'Spécialiste du marché de prestige dans le Morbihan (Baden, Arradon)',
    uptime: 99.8,
    requetes: 2.4
  }
];
---

<Layout title="AI Station - Control Center">
  <div class="ai-station">
    <!-- Simple Header sans boutons énormes -->
    <p><br><br><br><br></p>
    <div class="page-intro">
      <div class="intro-badge">AI Station</div>
      <h1>Interface de monitoring pour vos agents CrewAI</h1>
      <p>Vérifiez vos jetons d'accès et pilotez vos déploiements immobiliers</p>
    </div>

    <!-- Stats compactes -->
    <div class="stats-row">
      <div class="stat-box">
        <div class="stat-num">{stats.agentsActifs}</div>
        <div class="stat-lbl">Agents Actifs</div>
      </div>
      <div class="stat-box">
        <div class="stat-num">{stats.uptimeMoyen}%</div>
        <div class="stat-lbl">Uptime Moyen</div>
      </div>
      <div class="stat-box">
        <div class="stat-num">{stats.requetes24h}k</div>
        <div class="stat-lbl">Requêtes/24h</div>
      </div>
    </div>

    <!-- API Status -->
    <section class="content-section">
      <div class="section-title">
        <h2>API Status</h2>
        <span class="live-indicator">● Live</span>
      </div>

      <div class="api-list">
        {apiServices.map((service) => (
          <div class="api-item">
            <div class="api-row">
              <span class="api-label">{service.name}</span>
              <span class="status-ok">✓ {service.status}</span>
            </div>
            <div class="api-desc">{service.type}</div>
          </div>
        ))}
      </div>

      <div class="info-note">
        ℹ️ <strong>Configuration :</strong> Les variables sont extraites du fichier .env. 
        Toute modification nécessite un redémarrage du serveur local.
      </div>
    </section>

    <!-- Active Agents -->
    <section class="content-section">
      <div class="section-title">
        <h2>Active Agents</h2>
        <button class="btn-sm">+ Deploy New</button>
      </div>

      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Agent</th>
              <th>Spécialité</th>
              <th>Uptime</th>
              <th>Requêtes</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            {activeAgents.map((agent) => (
              <tr>
                <td>
                  <div class="agent-cell">
                    <div class="agent-icon">👤</div>
                    <div>
                      <div class="agent-title">{agent.name}</div>
                      <div class="agent-sub">{agent.core}</div>
                    </div>
                  </div>
                </td>
                <td class="specialty-cell">{agent.specialite}</td>
                <td>
                  <div class="uptime-bar">
                    <div class="bar-fill" style={`width: ${agent.uptime}%`}></div>
                  </div>
                  <span class="uptime-text">{agent.uptime}%</span>
                </td>
                <td><span class="req-badge">{agent.requetes}k</span></td>
                <td><span class="status-active">● active</span></td>
                <td>
                  <a href="/ai/robot001" class="btn-manage">
                    <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    Gérer
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>

<style>
  .ai-station {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 24px;
  }

  /* === INTRO === */
  .page-intro {
    margin-bottom: 32px;
  }

  .intro-badge {
    display: inline-block;
    background: #e0e7ff;
    color: #4338ca;
    padding: 4px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .page-intro h1 {
    font-size: 28px;
    font-weight: 700;
    color: #111827;
    margin: 0 0 8px 0;
  }

  .page-intro p {
    font-size: 16px;
    color: #6b7280;
    margin: 0;
  }

  /* === STATS === */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }

  .stat-box {
    background: white;
    padding: 20px;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
    text-align: center;
  }

  .stat-num {
    font-size: 32px;
    font-weight: 700;
    color: #4f46e5;
    margin-bottom: 4px;
  }

  .stat-lbl {
    font-size: 13px;
    color: #6b7280;
    font-weight: 500;
  }

  /* === SECTIONS === */
  .content-section {
    background: white;
    padding: 24px;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
    margin-bottom: 24px;
  }

  .section-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .section-title h2 {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
    margin: 0;
  }

  .live-indicator {
    color: #10b981;
    font-size: 13px;
    font-weight: 600;
  }

  .btn-sm {
    padding: 6px 14px;
    background: #4f46e5;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-sm:hover {
    background: #4338ca;
  }

  /* === API LIST === */
  .api-list {
    display: grid;
    gap: 12px;
    margin-bottom: 20px;
  }

  .api-item {
    padding: 12px 16px;
    background: #f9fafb;
    border-radius: 6px;
    border: 1px solid #e5e7eb;
  }

  .api-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .api-label {
    font-size: 13px;
    font-weight: 600;
    color: #374151;
  }

  .status-ok {
    font-size: 12px;
    color: #059669;
    font-weight: 600;
  }

  .api-desc {
    font-size: 12px;
    color: #6b7280;
  }

  .info-note {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    padding: 12px 16px;
    border-radius: 6px;
    font-size: 13px;
    color: #1e40af;
  }

  /* === TABLE === */
  .table-container {
    overflow-x: auto;
    margin-top: 16px;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .data-table th {
    text-align: left;
    padding: 12px;
    background: #f9fafb;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    color: #6b7280;
    border-bottom: 2px solid #e5e7eb;
  }

  .data-table td {
    padding: 16px 12px;
    border-bottom: 1px solid #e5e7eb;
  }

  .data-table tbody tr:hover {
    background: #f9fafb;
  }

  .agent-cell {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .agent-icon {
    width: 32px;
    height: 32px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
  }

  .agent-title {
    font-weight: 600;
    color: #111827;
    font-size: 14px;
  }

  .agent-sub {
    font-size: 11px;
    color: #6b7280;
    font-family: monospace;
  }

  .specialty-cell {
    font-size: 13px;
    color: #6b7280;
    max-width: 400px;
  }

  .uptime-bar {
    height: 4px;
    background: #e5e7eb;
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 4px;
  }

  .bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #10b981, #059669);
  }

  .uptime-text {
    font-size: 12px;
    font-weight: 600;
    color: #374151;
  }

  .req-badge {
    background: #f3f4f6;
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
  }

  .status-active {
    color: #2563eb;
    font-size: 13px;
    font-weight: 600;
  }

  .btn-manage {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: #4f46e5;
    color: white;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-manage:hover {
    background: #4338ca;
    transform: translateY(-1px);
  }

  .btn-manage .btn-icon {
    width: 14px;
    height: 14px;
  }

  /* === RESPONSIVE === */
  @media (max-width: 768px) {
    .ai-station {
      padding: 24px 16px;
    }

    .page-intro h1 {
      font-size: 22px;
    }

    .stats-row {
      grid-template-columns: 1fr;
    }

    .data-table {
      font-size: 12px;
    }

    .data-table th,
    .data-table td {
      padding: 10px 8px;
    }
  }
</style>
