---
// src/pages/prochainement.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Prochainement - We The Agency">
  <div class="coming-soon-page">
    <!-- Image de fond avec transparence -->
    <div class="background-image"></div>
    
    <!-- Overlay pour améliorer la lisibilité -->
    <div class="overlay"></div>
    
    <!-- Contenu principal -->
    <div class="content">

      <!-- Titre principal avec animation -->
      <h1 class="title">
        <span class="word">Prochainement</span>
        <span class="dots-animated">
          <span>.</span>
          <span>.</span>
          <span>.</span>
        </span>
      </h1>
      
      <!-- Sous-titre -->
      <p class="subtitle">Quelque chose d'extraordinaire arrive bientôt</p>
      
      <!-- Animation de chargement -->
      <div class="loading-bar">
        <div class="progress"></div>
      </div>
      
      <!-- Message secondaire -->
      <p class="message">
        Nous travaillons sur quelque chose d'exceptionnel.<br>
        Restez connecté pour découvrir la suite.
      </p>
      
      <!-- Lien de retour -->
      <a href="/" class="back-link">
        <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Retour à l'accueil
      </a>

      <!-- Accès Protégé -->
      <p class="message"></p>
      <a href="/ai" class="back-link">
        <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Accès protégé
      </a>
    </div>
  </div>
</Layout>

<style>
  .coming-soon-page {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  /* === IMAGE DE FOND AVEC TRANSPARENCE === */
  .background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('/images/conciergerie2.webp'); /* ⚠️ REMPLACEZ PAR VOTRE IMAGE */
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.2; /* 30% de transparence */
    z-index: 1;
  }

  /* Overlay pour améliorer le contraste */
  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(46, 34, 24, 0.3) 0%, rgba(205, 118, 37, 0.36) 100%);
    z-index: 2;
  }

  /* === CONTENU === */
  .content {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 40px 24px;
    max-width: 800px;
    animation: fadeInUp 1s ease-out;
      padding-top: 100px; /* Marge réduite sur mobile */
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* === DOTS DECORATION === */
  .dots {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 40px;
  }

  .dots span {
    width: 12px;
    height: 12px;
    background: white;
    border-radius: 50%;
    animation: bounce 1.4s infinite ease-in-out both;
  }

  .dots span:nth-child(1) { animation-delay: -0.32s; }
  .dots span:nth-child(2) { animation-delay: -0.16s; }

  @keyframes bounce {
    0%, 80%, 100% {
      transform: scale(0);
      opacity: 0.5;
    }
    40% {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* === TITRE === */
  .title {
    font-size: clamp(48px, 8vw, 80px);
    font-weight: 800;
    color: white;
    margin: 0 0 24px 0;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .word {
    animation: glow 2s ease-in-out infinite alternate;
  }

  @keyframes glow {
    from {
      text-shadow: 0 0 10px rgba(255, 255, 255, 0.5),
                   0 0 20px rgba(255, 255, 255, 0.3);
    }
    to {
      text-shadow: 0 0 20px rgba(255, 255, 255, 0.8),
                   0 0 40px rgba(255, 255, 255, 0.5);
    }
  }

  /* === DOTS ANIMÉS === */
  .dots-animated {
    display: inline-flex;
    gap: 4px;
  }

  .dots-animated span {
    animation: blink 1.4s infinite both;
    font-size: 1em;
  }

  .dots-animated span:nth-child(1) { animation-delay: 0s; }
  .dots-animated span:nth-child(2) { animation-delay: 0.2s; }
  .dots-animated span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes blink {
    0%, 20% { opacity: 0; }
    50% { opacity: 1; }
    100% { opacity: 0; }
  }

  /* === SOUS-TITRE === */
  .subtitle {
    font-size: clamp(18px, 3vw, 24px);
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 48px 0;
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  /* === BARRE DE CHARGEMENT === */
  .loading-bar {
    width: 100%;
    max-width: 400px;
    height: 4px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    overflow: hidden;
    margin: 0 auto 40px;
  }

  .progress {
    height: 100%;
    background: linear-gradient(90deg, 
      rgba(255, 255, 255, 0.8) 0%, 
      rgba(255, 255, 255, 1) 50%, 
      rgba(255, 255, 255, 0.8) 100%);
    border-radius: 2px;
    animation: loading 2s ease-in-out infinite;
  }

  @keyframes loading {
    0% {
      width: 0%;
      margin-left: 0%;
    }
    50% {
      width: 75%;
      margin-left: 0%;
    }
    100% {
      width: 0%;
      margin-left: 100%;
    }
  }

  /* === MESSAGE === */
  .message {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 48px 0;
    line-height: 1.6;
  }

  /* === LIEN RETOUR === */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.3);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }

  .back-link:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateX(-4px);
  }

  .back-link .icon {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .back-link:hover .icon {
    transform: translateX(-4px);
  }

  /* === RESPONSIVE === */
  @media (max-width: 768px) {
    .content {
      padding: 24px 16px;
        padding-top: 60px; /* Marge réduite sur mobile */
    }

    .title {
      font-size: 40px;
    }

    .subtitle {
      font-size: 16px;
    }

    .message {
      font-size: 14px;
    }
  }

  /* === ANIMATIONS SUPPLÉMENTAIRES === */
  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  /* Effet de particules flottantes (optionnel) */
  .content::before {
    content: '';
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
    border-radius: 50%;
    animation: float 6s ease-in-out infinite;
    pointer-events: none;
  }
</style>