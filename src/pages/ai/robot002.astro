---
import Layout from '../../layouts/Layout.astro';
import Login from '../../components/loginComponent.astro';
const isDev = import.meta.env.DEV;
---

<Login />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">

<Layout title="Robot002 – Email Automation">
  <div class="robot-container">
    <p><br><br><br><br><br></p>
    <h1>Robot002 – Email Automation</h1>

    {import.meta.env.DEV && (
      <div class="sandbox-banner">
        Mode SANDBOX — aucun email ne sera envoyé en local
      </div>
    )}

    <p class="robot-description">
      Robot002 est un agent autonome chargé d’envoyer des emails automatiquement selon une fréquence définie.
      Il utilise <strong>HuggingFace</strong> pour générer le contenu du message et un <strong>CRON serveur</strong> pour l’envoi.
      Configurez le destinataire, le prompt et la fréquence, puis laissez l’agent travailler pour vous.
    </p>

    <!-- DESTINATAIRE -->
    <div class="form-group">
      <label>Destinataire</label>
      <input id="emailTarget" type="email" placeholder="ex: x@tondomaine.com" />
    </div>

    <!-- PROMPT -->
    <div class="form-group">
      <label>Prompt HuggingFace</label>
      <textarea id="emailPrompt" rows="4">
Donne moi la version de ton moteur IA.
      </textarea>
    </div>

<!-- REGION -->
<div class="form-group">
  <label>Région ciblée</label>
  <input id="region" type="text" placeholder="Morbihan" />
</div>

<!-- PRIX MINIMUM -->
<div class="form-group">
  <label>Prix minimum (€)</label>
  <input id="minPrice" type="number" placeholder="1000000" />
</div>

<!-- SOURCES -->
<div class="form-group">
  <label>Sources (séparées par des virgules)</label>
  <input id="sources" type="text" placeholder="leboncoin,pap" />
</div>



    <!-- FREQUENCE -->
    <div class="form-group">
      <label>Fréquence d’envoi</label>
      <select id="frequencyType">
        <option value="minutes">Toutes les X minutes</option>
        <option value="hours">Toutes les X heures</option>
        <option value="days">Tous les X jours</option>
        <option value="weeks">Toutes les X semaines</option>
        <option value="months">Tous les X mois</option>
      </select>


      <input id="frequencyValue" type="number" min="1" value="1" />
      <span>minutes</span>
    </div>

    <!-- BOUTONS -->
    <button id="startRobot">Activer Robot002</button>
    <button id="stopRobot">Désactiver</button>
    <button id="sendNow">Envoyer maintenant</button>
    <button id="testRobot">Tester Robot002</button>
    <button id="saveConfig">💾 Sauvegarder la configuration</button>

    <!-- APERCU -->
    <div class="preview-panel">
      <h3>Aperçu de l’email généré</h3>
      <div id="emailPreview" class="preview-box"></div>
    </div>

    <!-- LOGS -->
    <div class="log-panel">
      <h3>Logs Robot002</h3>
    <div id="logOutput"></div>
</div>

    <div class="status-panel">
      <h3>État du robot</h3>
      <div id="robotState">Chargement…</div>
    </div>

    <!-- STATUT -->
    <div id="status"></div>
  </div>
</layout>



<script define:vars={{ isDev }}>
  window.__IS_DEV__ = isDev;
</script>


<script is:client="load">

window.onload = () => {
  let intervalId = null;

  function computeInterval(type, value) {
    const v = parseInt(value);
    switch (type) {
      case "minutes": return v * 60_000;
      case "hours": return v * 60 * 60_000;
      case "days": return v * 24 * 60 * 60_000;
      case "weeks": return v * 7 * 24 * 60 * 60_000;
      case "months": return v * 30 * 24 * 60 * 60_000;
    }
  }

  function log(message) {
  const logOutput = document.getElementById("logOutput");
  const entry = document.createElement("div");

  const now = new Date().toLocaleTimeString("fr-FR", {
    timeZone: "Europe/Paris",
    hour12: false
  });
  entry.textContent = `[${now}] ${message}`;
  logOutput.prepend(entry);
  }

document.getElementById("saveConfig").onclick = async () => {
  const isLocal = window.__IS_DEV__;

  if (isLocal) {
    log("🚫 Mode SANDBOX — sauvegarde impossible en local");
    return;
  }

  const payload = {
    to: document.getElementById("emailTarget").value,
    prompt: document.getElementById("emailPrompt").value,
    frequency_minutes: document.getElementById("frequencyValue").value,
    region: document.getElementById("region").value,
    min_price_eur: parseInt(document.getElementById("minPrice").value),
    sources: document.getElementById("sources").value.split(",").map(s => s.trim())
  };

  await fetch("/robot002-config.php", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload)
  });

  log("💾 Configuration sauvegardée");
  loadRobotStatus();
};

  // 🔵 Fonction centrale : envoi structuré vers HuggingFace
  async function callRobotEngine(prompt) {
    const payload = {
      data: [
        JSON.stringify({
          region: "Morbihan",
          min_price_eur: 1000000,
          sources: ["leboncoin", "pap"],
          prompt: prompt
        })
      ]
    };

    const response = await fetch("https://xperruche-robot002.hf.space/run/predict", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });

    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }

    const result = await response.json();
    return result.data?.[0] || "Message automatique.";
  }

  // 🔵 TEST MANUEL
  async function generateEmailContent(prompt, destinataire, contexte) {
    const fullPrompt = `Tu es Robot002, un agent chargé de générer des emails professionnels.

Destinataire : ${destinataire}
Contexte : ${contexte}

Consigne :
${prompt}

Génère un email clair, professionnel, concis et utile.`;

    log('📤 Envoi vers HuggingFace...');

    try {
      const content = await callRobotEngine(fullPrompt);
      log('✅ Email généré avec succès');
      return content;
    } catch (error) {
      log(`❌ Erreur: ${error.message}`);
      return `Erreur: ${error.message}`;
    }
  }

  // 🔵 Envoi email manuel (ne touche pas HuggingFace)
  async function sendEmail(to, content) {
    const isLocal = window.__IS_DEV__;

    if (isLocal) {
      log(`📨 [SANDBOX] Email simulé pour ${to}`);
      return;
    }

    await fetch("/send-email.php", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        to,
        subject: "Message automatique Robot002",
        message: content
      })
    });
  }

  // 🔵 Bouton TEST
  document.getElementById("testRobot").onclick = async () => {
    const to = document.getElementById("emailTarget").value;
    const prompt = document.getElementById("emailPrompt").value;

    if (!to) {
      alert("Destinataire manquant");
      return;
    }

    const previewBox = document.getElementById("emailPreview");
    previewBox.innerText = "⏳ Génération en cours…";
    log('Test manuel lancé');

    const content = await generateEmailContent(prompt, to, "Test manuel");
    previewBox.innerText = content;
  };

  // 🟢 ACTIVER ROBOT
  document.getElementById("startRobot").onclick = async () => {
  const isLocal = window.__IS_DEV__;

  if (isLocal) {
    log("🚫 Mode SANDBOX — activation impossible en local");
    document.getElementById("status").innerText = "Activation impossible en SANDBOX";
    return;
  }

  const payload = {
    active: true,
    to: document.getElementById("emailTarget").value,
    prompt: document.getElementById("emailPrompt").value,
    frequency_minutes: document.getElementById("frequencyValue").value,
    region: document.getElementById("region").value,
    min_price_eur: parseInt(document.getElementById("minPrice").value),
    sources: document.getElementById("sources").value.split(",").map(s => s.trim())
  };

  await fetch("/robot002-config.php", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload)
  });

  log("🤖 Robot002 activé côté serveur");
  document.getElementById("status").innerText = "Robot002 activé côté serveur";
  };

  // 🔴 DESACTIVER ROBOT
  document.getElementById("stopRobot").onclick = async () => {
    const isLocal = window.__IS_DEV__;

    if (isLocal) {
      log("🚫 Mode SANDBOX — désactivation impossible en local");
      document.getElementById("status").innerText = "Désactivation impossible en SANDBOX";
      return;
    }

    await fetch("/robot002-config.php", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ active: false })
    });

    log("🛑 Robot002 désactivé côté serveur");
    document.getElementById("status").innerText = "Robot002 désactivé côté serveur";
  };

  // 🔵 STATUT ROBOT
async function loadRobotStatus() {
  const isLocal = window.__IS_DEV__;
  const box = document.getElementById("robotState");

  if (isLocal) {
    box.innerHTML = `
      <p>🚫 État du robot indisponible en mode SANDBOX</p>
      <p>Aucun appel serveur n'est effectué.</p>
    `;
    return;
  }

  const res = await fetch("/robot002-status.php");
  const data = await res.json();

  // Sécurisation des champs manquants
  const region = data.region ?? "Non défini";
  const minPrice = data.min_price_eur ?? 0;
  const sources = Array.isArray(data.sources) ? data.sources : [];
  const prompt = data.prompt ?? "";
  const to = data.to ?? "";
  const freq = data.frequency_minutes ?? "";
  const logs = Array.isArray(data.log_tail) ? data.log_tail : [];

  // Mise à jour du panneau d’état
  box.innerHTML = `
    <p><strong>Statut :</strong> ${data.active ? "🟢 Activé" : "🔴 Désactivé"}</p>
    <p><strong>Adresse email :</strong> ${to}</p>
    <p><strong>Région ciblée :</strong> ${region}</p>
    <p><strong>Prix minimum :</strong> ${minPrice} €</p>
    <p><strong>Sources :</strong> ${sources.join(", ")}</p>
    <p><strong>Prompt :</strong> ${prompt}</p>
    <p><strong>Fréquence :</strong> ${freq} minute(s)</p>
    <p><strong>Dernier envoi :</strong> ${data.last_sent ?? "Jamais"}</p>
    <p><strong>Prochaine exécution :</strong> ${data.next_run ?? "N/A"}</p>
    <p><strong>Derniers logs :</strong></p>
    <pre>${logs.join("\n")}</pre>
  `;

  // Mise à jour automatique des champs du formulaire
document.getElementById("emailTarget").value = to;
document.getElementById("emailPrompt").value = prompt;
document.getElementById("frequencyValue").value = freq;
document.getElementById("region").value = region;
document.getElementById("minPrice").value = minPrice;
document.getElementById("sources").value = sources.join(",");
}
  loadRobotStatus();
  if (!window.__IS_DEV__) {
    setInterval(loadRobotStatus, 20000);
  }

  // ⚡ ENVOI IMMEDIAT
  document.getElementById("sendNow").onclick = async () => {
    const isLocal = window.__IS_DEV__;

    if (isLocal) {
      log("🚫 Mode SANDBOX — envoi immédiat impossible en local");
      document.getElementById("status").innerText = "Envoi immédiat impossible en SANDBOX";
      return;
    }

    log("⚡ Envoi immédiat demandé…");

    const res = await fetch("/robot002-run-now.php");
    const data = await res.json();

    if (data.status === "ok") {
      log("📨 Email envoyé immédiatement !");
      document.getElementById("status").innerText = "Email envoyé immédiatement";
    } else {
      log("❌ Erreur lors de l’envoi immédiat");
      document.getElementById("status").innerText = "Erreur lors de l’envoi immédiat";
    }

    loadRobotStatus();
  };
}; // ← FIN window.onload

</script>

  <style>

        .status-panel {
          margin-top: 20px;
          padding: 15px;
          border: 1px solid #ddd;
          border-radius: 8px;
          background: #fafafa;
        }


        .preview-panel {
          margin-top: 20px;
          padding: 15px;
          border: 1px solid #ddd;
          border-radius: 8px;
          background: #fafafa;
        }

        .preview-box {
          white-space: pre-wrap;
          padding: 10px;
          background: white;
          border-radius: 6px;
          border: 1px solid #eee;
          min-height: 80px;
        }

      .log-panel {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        padding: 16px;
        border-radius: 8px;
        margin-top: 30px;
        max-height: 250px;
        overflow-y: auto;
        font-family: monospace;
        font-size: 13px;
      }

      .log-panel h3 {
        margin-top: 0;
        font-size: 15px;
        color: #374151;
      }

      #logOutput div {
        margin-bottom: 6px;
        padding-bottom: 6px;
        border-bottom: 1px dashed #e5e7eb;
      }

    .sandbox-banner {
      background: #ffe8a3;
      color: #7a5a00;
      padding: 10px;
      border-radius: 6px;
      margin-bottom: 20px;
      font-weight: 600;
    }


    .robot-container {
      max-width: 700px;
      margin: 40px auto;
    }
    .robot-description {
      background: #f3f4f6;
      padding: 16px;
      border-radius: 8px;
      margin-bottom: 24px;
      font-size: 15px;
      line-height: 1.6;
    }
    .form-group {
      margin-bottom: 20px;
    }
    input, textarea, select {
      width: 100%;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid #ddd;
      font-size: 15px;
    }


.button-row button {
  flex: 1;
  min-width: 180px;
  padding: 12px 18px;
  border: none;
  border-radius: 6px;
  background: #1a1a1a;
  color: white;
  font-size: 15px;
  cursor: pointer;
  transition: background 0.2s ease;
}

.button-row button:hover {
  background: #333;
}
    #status {
      margin-top: 20px;
      font-size: 14px;
      color: #374151;
    }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .spinner {
    width: 16px;
    height: 16px;
    animation: spin 1s linear infinite;
  }

  .spinner.hidden {
    display: none;
  }

  .animate-fade-in {
    animation: fadeIn 0.5s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<style is:global>
  /* === GLOBAL RESET & BLINDAGE === */
  :root {
    --color-wta-dark: #111827; /* Noir Weopup */
    --color-wta-gray-light: #fafafa;
    --color-wta-gray-medium: #6b7280;
    --color-wta-accent: #4f46e5; /* Violet stats */
    --color-border: #e5e7eb;
    --font-family-main: 'Inter', sans-serif; /* Assure-toi que Inter est chargée */
  }

  body {
    margin: 0;
    padding: 0;
    background-color: var(--color-wta-gray-light);
    font-family: var(--font-family-main);
    color: #333;
  }

  /* Force le box-sizing pour tous les éléments pour éviter les débordements */
  *, *::before, *::after {
    box-sizing: border-box;
  }


/* Réduction de la police et du poids */
.report-content {
  font-size: 13px !important; /* Plus petit (était 14px) */
  line-height: 1.7;
  color: #4b5563; /* Gris plus doux */
  text-align: left;
  white-space: normal;
  font-weight: 400; /* Normal, pas gras */
}

/* Titres moins gras et plus petits */
.report-content h1, 
.report-content h2, 
.report-content h3 {
  color: #111827;
  font-weight: 600 !important; /* Moins gras (était 700) */
  margin-top: 1.5em;
  margin-bottom: 0.5em;
  display: block;
}

.report-content h1 { 
  font-size: 1.25rem !important; /* Plus petit (était 1.5rem) */
  border-bottom: 1px solid #e5e7eb; 
  padding-bottom: 10px; 
}

.report-content h2 { 
  font-size: 1.1rem !important; /* Plus petit (était 1.25rem) */
}

.report-content h3 { 
  font-size: 1rem !important; /* Plus petit (était 1.1rem) */
}

/* Paragraphes */
.report-content p { 
  margin-bottom: 0.8rem;
  font-weight: 400; /* Normal */
}

/* Listes */
.report-content ul, 
.report-content ol {
  margin-bottom: 0.8rem;
  padding-left: 1.5rem;
  list-style-type: disc;
  font-weight: 400; /* Normal */
}

.report-content li {
  margin-bottom: 0.4rem;
  font-weight: 400; /* Normal */
}

/* Strong/Bold moins prononcé */
.report-content strong { 
  font-weight: 600 !important; /* Moins gras (était 700) */
  color: #1f2937; /* Gris foncé au lieu de noir */
}

/* === LIENS CLIQUABLES === */
.report-content a {
  color: #4f46e5 !important;
  text-decoration: underline !important;
  font-weight: 500;
  transition: all 0.2s ease;
  cursor: pointer !important;
  display: inline !important; /* Important pour que le lien reste inline */
}

.report-content a:hover {
  color: #4338ca !important;
  text-decoration: none !important;
}

.report-content a:visited {
  color: #7c3aed !important;
}

/* Force les liens à être cliquables même s'ils sont dans d'autres éléments */
.report-content p a,
.report-content li a,
.report-content div a {
  pointer-events: auto !important;
  cursor: pointer !important;
}

/* Console link (si vous utilisez cette classe) */
.console-link {
  color: #4f46e5 !important;
  text-decoration: underline !important;
  font-weight: 500;
  transition: opacity 0.2s;
  cursor: pointer !important;
}

.console-link:hover { 
  opacity: 0.8; 
}
</style>

<style>

  .report-content {
    /* Annule le comportement "texte brut" pour laisser le HTML s'afficher */
    white-space: normal !important; 
    word-break: break-word;
    font-family: 'Inter', sans-serif;
    color: #374151;
  }

  .report-content strong {
    font-weight: 700;
    color: #000;
  }

  .report-content br {
    display: block;
    content: "";
    margin-top: 8px;
  }

    .console-link {
      color: #4f46e5;
      text-decoration: underline;
      font-weight: 600;
      display: inline-block;
      margin-top: 5px;
    }

  /* === LAYOUT CONTEUR === */
  .robot-page {
    max-width: 1600px; /* Largeur max soignée */
    margin: 0 auto; /* CENTRE LE CONTEUR PRINCIPAL */
    padding: 40px 10px 80px; /* Padding généreux */
  }

  /* === BREADCRUMB === */
  .breadcrumb {
    display: inline-block;
    font-size: 11px;
    color: #a1a7b3;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 24px;
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb:hover {
    color: var(--color-wta-dark);
  }

  /* === EN-TÊTE DE LA PAGE === */
  .page-header {
    margin-bottom: 40px;
    position: relative;
  }

  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start; /* Aligne le badge au top du titre */
    gap: 24px;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .agent-badge-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fdfdfd;
    border: 1px solid #eee;
    padding: 8px 16px;
    border-radius: 99px;
    margin-bottom: 16px;
  }

  .agent-emoji {
    font-size: 18px;
  }

  .agent-id {
    font-size: 11px;
    font-weight: 700;
    font-family: monospace; /* Type code */
    color: var(--color-wta-dark);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .page-header h1 {
    font-size: 38px;
    font-weight: 800;
    color: var(--color-wta-dark);
    letter-spacing: -0.04em;
    margin: 0 0 10px 0;
  }

  .subtitle {
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-wta-gray-medium);
    font-weight: 300;
    margin: 0;
    max-width: 480px;
  }

  .status-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    padding: 10px 18px;
    border-radius: 99px;
    white-space: nowrap; /* Évite de couper le texte */
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
  }

  .status-dot.active {
    animation: pulse 2.5s infinite;
  }

  .status-text {
    font-size: 12px;
    font-weight: 700;
    color: #065f46;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* === STATS RAPIDES === */
  .quick-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr); /* 3 colonnes égales */
    gap: 16px;
    margin-bottom: 40px;
  }

  .stat-mini {
    background: white;
    border: 1px solid var(--color-border);
    padding: 24px;
    border-radius: 16px;
    text-align: center;
    transition: box-shadow 0.3s ease;
  }

  .stat-mini:hover {
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
  }

  .stat-mini-value {
    font-size: 32px;
    font-weight: 800;
    color: var(--color-wta-accent);
    margin-bottom: 6px;
  }

  .stat-mini-label {
    font-size: 11px;
    color: var(--color-wta-gray-medium);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
  }

  /* === GRILLE PRINCIPALE === */
  .main-grid {
    display: grid;
    grid-template-columns: 1fr 1fr; /* 2 colonnes égales */
    gap: 24px;
  }

  /* === COLONNE GAUCHE : CONFIGURATION === */
  .config-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .section-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 32px; /* Padding généreux */
  }

  .card-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-wta-dark);
    margin: 0 0 32px 0;
  }

  .agent-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .agent-config {
    padding: 24px;
    background: #fafafa;
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .agent-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .agent-label {
    font-size: 12px;
    font-weight: 700;
    color: #374151;
