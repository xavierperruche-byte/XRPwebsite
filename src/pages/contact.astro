---
import Layout from '../layouts/Layout.astro';

// Add your reCAPTCHA site key here
const RECAPTCHA_SITE_KEY = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;

// Define your projects/exhibitions data
const projects = [
  {
    id: 1,
    title: 'Contact',
    type: '',
    year: 2025,
    image: '/images/contact2.webp',
    slug: '',
    description: 'Contact'
  },
  {
    id: 2,
    title: 'Contact',
    type: '',
    year: 2025,
    image: '/images/contact.webp',
    slug: '',
    description: 'Contact'
 }
];
---

<Layout title="Contact Us">
      <div class="slider-container">
      {projects.map((project, index) => (
        <div class={`slide ${index === 0 ? 'active' : ''}`} data-slide={index}>
          <div class="slide-background">
            <img src={project.image} alt={project.title} class="slide-image" />
            <div class="slide-overlay"></div>
          </div>
        </div>
      ))}
            <div class="slide-content">
              <div class="slide-info">
                <div class="spacer-top"></div>
                <div class="contact-container">
                  <div class="form-wrapper">
                    <div class="form-header">
                      <div class="header-accent"></div>
                      <h1>Prenons Contact</h1>
                      <p>Transformons vos idées en réalité</p>
                    </div>

                    <div class="success-message" id="successMessage">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span>Message envoyé avec succès! Nous vous répondrons très prochainement.</span>
                    </div>
                    
                    <div class="error-message" id="errorMessage">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                      </svg>
                      <span>Une erreur s'est produite. Veuillez réessayer.</span>
                    </div>

                    <form id="contactForm" action="/contact-handler.php" method="POST">
                      <div class="form-row">
                        <div class="form-group">
                          <label for="name">
                            <span class="label-text">Nom</span>
                            <span class="label-required">*</span>
                          </label>
                          <input 
                            type="text" 
                            id="name" 
                            name="name" 
                            required 
                            placeholder="Jean Dupont"
                          />
                        </div>

                        <div class="form-group">
                          <label for="email">
                            <span class="label-text">Email</span>
                            <span class="label-required">*</span>
                          </label>
                          <input 
                            type="email" 
                            id="email" 
                            name="email" 
                            required 
                            placeholder="jean@exemple.com"
                          />
                        </div>
                      </div>

                      <div class="form-group">
                        <label for="subject">
                          <span class="label-text">Objet</span>
                          <span class="label-required">*</span>
                        </label>
                        <input 
                          type="text" 
                          id="subject" 
                          name="subject" 
                          required 
                          placeholder="Comment pouvons-nous vous aider ?"
                        />
                      </div>

                      <div class="form-group">
                        <label for="message">
                          <span class="label-text">Message</span>
                          <span class="label-required">*</span>
                        </label>
                        <textarea 
                          id="message" 
                          name="message" 
                          required 
                          placeholder="Partagez vos idées avec nous..."
                        ></textarea>
                      </div>

                      <button type="submit" class="submit-btn" id="submitBtn">
                        <span class="btn-text">Envoyer le message</span>
                        <svg class="btn-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </button>

                      <div class="recaptcha-notice">
                        Protégé par reCAPTCHA · 
                        <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Confidentialité</a> · 
                        <a href="https://policies.google.com/terms" target="_blank" rel="noopener">Conditions</a>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>
            </div>
          </div>
      </div>

      <!-- Slider Indicators -->
      <div class="slider-indicators">
        {projects.map((_, index) => (
          <button 
            class={`indicator ${index === 0 ? 'active' : ''}`}
            data-slide={index}
            aria-label={`Go to slide ${index + 1}`}
          ></button>
        ))}
      </div>

</Layout>

<!-- Load reCAPTCHA v3 - CORRIGÉ -->
<script is:inline define:vars={{ RECAPTCHA_SITE_KEY }}>
  // Charger reCAPTCHA dynamiquement
  (function() {
    const script = document.createElement('script');
    script.src = `https://www.google.com/recaptcha/api.js?render=${RECAPTCHA_SITE_KEY}`;
    script.async = true;
    script.defer = true;
    document.head.appendChild(script);
  })();
</script>

<script define:vars={{ RECAPTCHA_SITE_KEY }}>
// Attendre que le DOM et reCAPTCHA soient chargés
window.addEventListener('load', function() {
  const form = document.getElementById('contactForm');
  const successMessage = document.getElementById('successMessage');
  const errorMessage = document.getElementById('errorMessage');
  const submitBtn = document.getElementById('submitBtn');

  if (!form) {
    console.error('Form not found!');
    return;
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    
    // Désactiver le bouton
    submitBtn.disabled = true;
    submitBtn.textContent = "Envoi en cours...";

    // Cacher les messages précédents
    successMessage.style.display = "none";
    errorMessage.style.display = "none";

    try {
      // Vérifier que grecaptcha est chargé
      if (typeof grecaptcha === 'undefined') {
        throw new Error("reCAPTCHA n'est pas chargé. Veuillez rafraîchir la page.");
      }

      console.log('Waiting for reCAPTCHA...');
      
      // Attendre que reCAPTCHA soit prêt et obtenir le token
      const token = await new Promise((resolve, reject) => {
        grecaptcha.ready(async () => {
          try {
            const t = await grecaptcha.execute(RECAPTCHA_SITE_KEY, { action: 'contact_form' });
            console.log('reCAPTCHA token obtained:', t ? 'YES' : 'NO');
            resolve(t);
          } catch (err) {
            reject(err);
          }
        });
      });

      if (!token) {
        throw new Error("Impossible d'obtenir un jeton reCAPTCHA.");
      }

      // Préparer les données
      const formData = new FormData(form);
      formData.append("recaptcha_token", token);

      console.log('Sending form data...');

      // Envoyer
      const response = await fetch(form.action, {
        method: "POST",
        body: formData,
        headers: { 
          "Accept": "application/json"
        }
      });

      console.log('Response status:', response.status);

      const result = await response.json();
      console.log('Response data:', result);

      if (response.ok && result.success) {
        successMessage.style.display = "block";
        errorMessage.style.display = "none";
        form.reset();
        submitBtn.textContent = "Message envoyé ✓";
        
        // Réinitialiser après 3 secondes
        setTimeout(() => {
          submitBtn.textContent = "Envoyez votre message";
          successMessage.style.display = "none";
        }, 3000);
      } else {
        throw new Error(result.message || result.error || "Erreur lors de l'envoi du formulaire.");
      }

    } catch (error) {
      console.error('Form submission error:', error);
      errorMessage.textContent = "✗ " + error.message;
      errorMessage.style.display = "block";
      successMessage.style.display = "none";
      submitBtn.textContent = "Envoyez votre message";
    } finally {
      submitBtn.disabled = false;
    }
  });

  // Slider functionality
  let currentSlide = 0;
  const slides = document.querySelectorAll('.slide');
  const indicators = document.querySelectorAll('.indicator');
  const totalSlides = slides.length;
  let autoSlideInterval = null;

  function showSlide(index) {
    slides.forEach(slide => slide.classList.remove('active'));
    indicators.forEach(indicator => indicator.classList.remove('active'));
    
    slides[index].classList.add('active');
    indicators[index].classList.add('active');
    currentSlide = index;
  }

  function nextSlide() {
    const next = (currentSlide + 1) % totalSlides;
    showSlide(next);
  }

  function prevSlide() {
    const prev = (currentSlide - 1 + totalSlides) % totalSlides;
    showSlide(prev);
  }

  function startAutoSlide() {
    if (autoSlideInterval) {
      clearInterval(autoSlideInterval);
      autoSlideInterval = null;
    }
    autoSlideInterval = setInterval(nextSlide, 5000);
  }

  function stopAutoSlide() {
    if (autoSlideInterval) {
      clearInterval(autoSlideInterval);
      autoSlideInterval = null;
    }
  }

  // Navigation buttons
  document.querySelector('.slider-nav.next')?.addEventListener('click', () => {
    nextSlide();
    stopAutoSlide();
    startAutoSlide();
  });

  document.querySelector('.slider-nav.prev')?.addEventListener('click', () => {
    prevSlide();
    stopAutoSlide();
    startAutoSlide();
  });

  // Indicators
  indicators.forEach((indicator, index) => {
    indicator.addEventListener('click', () => {
      showSlide(index);
      stopAutoSlide();
      startAutoSlide();
    });
  });

  // Start auto-advance
  startAutoSlide();

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      prevSlide();
      stopAutoSlide();
      startAutoSlide();
    }
    if (e.key === 'ArrowRight') {
      nextSlide();
      stopAutoSlide();
      startAutoSlide();
    }
  });
});
</script>

<style>
    html, body {
      height: 100%;
      min-height: 100vh;
      margin: 0;
      padding: 0;
      font-family: var(--font-main), -apple-system, BlinkMacSystemFont, 'Segoe UI', Urbanist, sans-serif;
    }

    .slider-container {
      position: relative;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      min-height: 1000px;
    }

    .slide {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      min-height: 1000px;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.8s ease-in-out, visibility 0.8s ease-in-out;
    }

    .slide.active {
      opacity: 1;
      visibility: visible;
      z-index: 10;
    }

    .slide-background {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    .slide-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      animation: kenburns 20s ease-out infinite;
      opacity: 0.55;
    }

    @keyframes kenburns {
      0%, 100% {
        transform: scale(1.05);
      }
      50% {
        transform: scale(1.15);
      }
    }

    .slide-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        to right,
        rgba(0, 0, 0, 0.7) 0%,
        rgba(0, 0, 0, 0.4) 50%,
        rgba(0, 0, 0, 0.2) 100%
      );
    }

    .slide-background::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(255, 255, 255, 0.15);
      z-index: 1;
    }

    .slide-content {
      position: relative;
      height: 100%;
      display: flex;
      align-items: center;
      padding: 0 2rem;
      max-width: 2000px;
      margin: 0 auto;
      z-index: 10;
    }

    .slide-info {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 20;
      max-width: 2000px;
      justify-content: center; 
      align-items: center;   
      flex-direction: column; 
      text-align: center;
      padding: 1px;
      color: rgba(255, 255, 255, 0);
      animation: slideIn 0.8s ease-out;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateX(-50px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .slide.active .slide-info {
      animation: slideIn 0.8s ease-out;
    }

    .slider-indicators {
      position: absolute;
      bottom: 3rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 1rem;
      z-index: 10;
    }

    .indicator {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0);
      border: none;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .indicator.active {
      background: rgba(255, 255, 255, 0);
      width: 40px;
      border-radius: 6px;
    }

    .contact-container {
      position: absolute;
      top: 50px;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 30;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .form-wrapper {
      background: rgba(255, 255, 255, 0.35);
      backdrop-filter: blur(10px);
      border-radius: 24px;
      padding: 2rem 6rem;
      max-width: 1000px;
      width: 100%;
      box-shadow: 
        0 20px 60px rgba(0, 0, 0, 0.25),
        0 0 1px rgba(255, 255, 255, 0.5) inset;
      border: 1px solid rgba(255, 255, 255, 0.3);
      animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }

    .form-wrapper::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #fff0ea 0%, #8d6868 50%, #eae3d8 100%);
      background-size: 200% 100%;
      animation: shimmer 3s ease-in-out infinite;
    }

    @keyframes shimmer {
      0%, 100% {
        background-position: 0% 0%;
      }
      50% {
        background-position: 100% 0%;
      }
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .form-header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .form-header h1 {
      font-size: 2.0rem;
      color: #2d3748;
      margin-bottom: 0.5rem;
    }

    .form-header p {
      color: #718096;
      font-size: 1.1rem;
    }

    .form-group {
      margin-bottom: 1.5rem;
      font-family: var(--font-main), -apple-system, BlinkMacSystemFont, 'Segoe UI', Urbanist, sans-serif;
    }

    label {
      display: block;
      color: #2d3748;
      font-weight: 600;
      margin-bottom: 0.5rem;
      font-size: 0.95rem;
      font-family: var(--font-main), -apple-system, BlinkMacSystemFont, 'Segoe UI', Urbanist, sans-serif;
    }

    input, textarea {
      width: 100%;
      padding: 0.875rem;
      border: 2px solid #e2e8f0;
      border-radius: 10px;
      font-size: 1rem;
      transition: all 0.3s ease;
      font-family: var(--font-main), -apple-system, BlinkMacSystemFont, 'Segoe UI', Urbanist, sans-serif;
    }

    input:focus, textarea:focus {
      outline: none;
      border-color: #fff0ea;
      box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    textarea {
      resize: vertical;
      min-height: 150px;
    }

    .submit-btn {
      width: 100%;
      padding: 1rem;
      background: linear-gradient(135deg, #8d6868 0%, #eae3d8 100%);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      margin-top: 1rem;
    }

    .submit-btn:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
    }

    .submit-btn:active:not(:disabled) {
      transform: translateY(0);
    }

    .submit-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .success-message {
      display: none;
      padding: 1rem;
      background: #48bb78;
      color: white;
      border-radius: 10px;
      margin-bottom: 1rem;
      text-align: center;
    }

    .error-message {
      display: none;
      padding: 1rem;
      background: #f56565;
      color: white;
      border-radius: 10px;
      margin-bottom: 1rem;
      text-align: center;
    }

    .recaptcha-notice {
      margin-top: 1.5rem;
      text-align: center;
      font-size: 0.85rem;
      color: #718096;
    }

    .recaptcha-notice a {
      color: #667eea;
      text-decoration: none;
    }

    .recaptcha-notice a:hover {
      text-decoration: underline;
    }

    .spacer-top {
      height: 100px;
    }

    @media (max-width: 768px) {
      .form-header h1 {
        font-size: 2rem;
      }
    }
</style>