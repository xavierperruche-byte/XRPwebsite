<script>
  const cover = document.getElementById('living-cover');
  const card = cover?.querySelector('.living-cover-card');

  if (cover && card && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const reset = () => {
      card.style.transform = 'rotateX(0deg) rotateY(0deg) translateZ(0)';
    };

    cover.addEventListener('pointermove', (event) => {
      const rect = cover.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width;
      const y = (event.clientY - rect.top) / rect.height;
      const rotateY = (x - 0.5) * 9;
      const rotateX = (0.5 - y) * 9;
      card.style.transform = `rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) translateZ(8px)`;
    });

    cover.addEventListener('pointerleave', reset);
  }
</script>