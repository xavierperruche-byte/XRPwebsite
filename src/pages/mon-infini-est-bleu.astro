---
<Layout title={title} description={description} currentPage="/magazine">
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="fr-FR" href={canonical} />

  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="author" content="Réjane Salaün" />

  <!-- Open Graph -->
  <meta property="og:type" content="book" />
  <meta property="og:site_name" content="We-TheAgency" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={coverImage} />
  <meta property="og:image:secure_url" content={coverImage} />
  <meta property="og:image:type" content="image/webp" />
  <meta property="og:image:width" content="900" />
  <meta property="og:image:height" content="1200" />
  <meta property="og:image:alt" content="Couverture du livre Mon infini est bleu de Réjane Salaün" />
  <meta property="og:locale" content="fr_FR" />

  <!-- Open Graph Book -->
  <meta property="book:isbn" content="979-8185716458" />
  <meta property="book:release_date" content="2026-07-02" />
  <meta property="book:tag" content="autisme au féminin" />
  <meta property="book:tag" content="neurodiversité" />
  <meta property="book:tag" content="diversité cognitive" />

  <!-- X / Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={coverImage} />
  <meta name="twitter:image:alt" content="Couverture du livre Mon infini est bleu de Réjane Salaün" />

  <main class="book-page">
    <nav class="book-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/">We-TheAgency</a>
      <span aria-hidden="true">/</span>
      <a href="/magazine">Magazine</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Mon infini est bleu</span>
    </nav>

    <div class="book-page-layout">
      <!-- Rail éditorial gauche : témoignages en mouvement -->
      <aside class="testimonial-rail" aria-labelledby="testimonials-title">
        <div class="testimonial-rail-inner">
          <div class="testimonial-rail-heading">
            <p class="rail-label">Regards de lecteurs</p>
            <h2 id="testimonials-title">Ils ont lu <em>Mon infini est bleu</em></h2>
          </div>

          <div class="testimonial-viewport">
            <div class="testimonial-track" id="testimonial-track">
              <div class="testimonial-group">
                {testimonials.map((testimonial) => (
                  <figure class="rail-testimonial">
                    <blockquote>{testimonial.quote}</blockquote>
                    <figcaption>— {testimonial.author}</figcaption>
                  </figure>
                ))}
              </div>

              <!-- Copie nécessaire à la boucle visuelle sans rupture. -->
              <div class="testimonial-group" aria-hidden="true">
                {testimonials.map((testimonial) => (
                  <figure class="rail-testimonial">
                    <blockquote>{testimonial.quote}</blockquote>
                    <figcaption>— {testimonial.author}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          </div>

          <div class="testimonial-rail-footer" aria-hidden="true">
            <span></span>
            <span>↓</span>
            <span></span>
          </div>
        </div>
      </aside>

      <!-- Corps principal : 2/3 de la largeur sur desktop -->
      <div class="book-main-column">
        <section class="book-hero" aria-labelledby="book-title">
          <div class="book-hero-inner">
            <div class="book-cover-column">
              <div class="living-cover" id="living-cover">
                <div class="living-cover-shadow" aria-hidden="true"></div>
                <div class="living-cover-card">
                  <img
                    src="/images/MonInfiniEstBleu.webp"
                    alt="Couverture du livre Mon infini est bleu de Réjane Salaün"
                    width="900"
                    height="1200"
                    loading="eager"
                    fetchpriority="high"
                  />
                  <span class="living-cover-shine" aria-hidden="true"></span>
                </div>
              </div>
              <p class="cover-caption">Mon infini est bleu · Réjane Salaün</p>
            </div>

            <div class="book-intro">
              <p class="eyebrow">Livre · Essai · Témoignage</p>
              <h1 id="book-title">Mon infini est bleu</h1>
              <p class="book-author-line">Réjane Salaün</p>

              <p class="book-pitch">
                <strong>Mon infini est bleu</strong> est le premier essai de <strong>Réjane Salaün</strong>,
                consacré à l'expérience de l'<strong>autisme au féminin</strong>, à la
                <strong>neurodiversité</strong> et à la manière dont nos différences de perception
                influencent notre rapport aux autres et au monde.

                Le récit part de scènes du quotidien pour parler de perception, de différence,
                de lien humain et de diversité cognitive.
              </p>

              <div class="book-actions" aria-label="Acheter le livre">
                <a
                  href="https://www.amazon.fr/Mon-infini-bleu-R%C3%A9jane-Sala%C3%BCn-ebook/dp/B0H49NMJW1/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="book-action book-action-primary"
                >
                  Kindle
                  <span aria-hidden="true">↗</span>
                </a>
                <a
                  href="https://www.amazon.fr/dp/B0H7Q92LKX/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="book-action"
                >
                  Broché
                  <span aria-hidden="true">↗</span>
                </a>
                <a
                  href="https://shop.we-theagency.com/product/moninfiniestbleu/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="book-action"
                >
                  Acheter en CHF
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </div>
        </section>

        <div class="page-divider" aria-hidden="true"></div>

        <section class="book-section book-details-section" aria-labelledby="book-details-title">
          <div class="section-number">01</div>
          <div class="section-copy section-copy-wide">
            <p class="section-label">Le livre</p>
            <h2 id="book-details-title">Fiche bibliographique</h2>
            <div class="book-details-grid">
              {bookDetails.map((detail) => (
                <div class="book-detail-item">
                  <dt>{detail.label}</dt>
                  <dd>{detail.value}</dd>
                </div>
              ))}
            </div>
          </div>
        </section>

        <div class="page-divider" aria-hidden="true"></div>

        <section class="book-section author-section" aria-labelledby="author-title">
          <div class="section-number">02</div>
          <div class="section-copy">
            <p class="section-label">L'autrice</p>
            <h2 id="author-title">Réjane Salaün</h2>
            <p>
              Réjane Salaün accompagne les femmes entrepreneures suisses dans leur développement commercial et digital.
              Fondatrice de We-TheAgency, elle développe depuis plusieurs années des projets à la croisée du digital,
              des rencontres et des initiatives à impact.
            </p>
            <p>
              Avec <em>Mon infini est bleu</em>, elle publie son premier essai et choisit une écriture ancrée dans les
              situations vécues : des scènes du quotidien, des décalages parfois invisibles et une réflexion sur la
              perception, le langage et la manière de trouver sa place.
            </p>
          </div>
          <div class="author-aside">
            <p>Perception</p>
            <p>Différence</p>
            <p>Neurodiversité</p>
            <p>Autisme au féminin</p>
          </div>
        </section>

        <div class="page-divider" aria-hidden="true"></div>

        <section class="book-section press-section" aria-labelledby="press-title">
          <div class="section-number">03</div>
          <div class="section-copy section-copy-wide">
            <p class="section-label">Presse</p>
            <h2 id="press-title">Références de presse</h2>
            <p class="section-intro">
              Articles, interviews et publications consacrés au parcours de Réjane Salaün et à
              <em>Mon infini est bleu</em>.
            </p>

        <div class="press-list">
          {pressReferences.map((reference) => (
            <article class="press-item">
              <div class="press-brand">
                {reference.logo === "tdg" && (
                <svg width="60%" height="60%" viewBox="0 0 128 50" xml:space="preserve" xmlns:serif="http://www.serif.com/" style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;" class="logo-img logo-light astro-4ivgp5cp" role="img" aria-label="Tribune de Genève">
                    <g>
                        <rect x="0" y="0" width="128" height="50" style="fill:none;"></rect>
                        <rect x="0" y="0" width="128.525" height="49.924" style="fill:rgb(44,56,144);"></rect>
