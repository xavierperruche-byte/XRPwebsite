---
import Layout from '../layouts/Layout.astro';

const title = "Mon infini est bleu — Réjane Salaün | We-TheAgency";
const description = "Mon infini est bleu, le récit de Réjane Salaün sur l'autisme au féminin, la diversité cognitive et les expériences du quotidien.";
const canonical = "https://www.we-theagency.com/mon-infini-est-bleu";
const coverImage = "https://www.we-theagency.com/images/MonInfiniEstBleu.webp";
const siteUrl = "https://www.we-theagency.com";
const lastUpdated = "2026-09-24";

const organizationId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;
const authorId = `${canonical}#author`;
const bookId = `${canonical}#book`;

const bookDetails = [
  { label: "Format", value: "Broché" },
  { label: "Pages", value: "140 pages" },
  { label: "Dimensions", value: "12,7 × 0,84 × 20,32 cm" },
  { label: "ISBN-13", value: "979-8185716458" },
  { label: "Langue", value: "Français" },
  { label: "Publication", value: "2 juillet 2026" },
  { label: "Poids", value: "209 g" }
];

const testimonials = [
  {
    quote: "Je trouve que c'est difficile de trouver des témoignages de vie quotidienne de personnes autistes. Des scènes vraiment précises, et ton livre c'est exactement ça.",
    author: "Instagram"
  },
  {
    quote: "Un livre incontournable pour décrypter, analyser, comprendre et surtout s'adapter aux personnes neuroatypiques en général, et autistes en particulier. C'est écrit avec une grande sensibilité, beaucoup d'humanité, et des touches d'humour qui rendent le sujet léger, alors qu'il est profond et sociétal.",
    author: "Arnaud M. · Amazon"
  },
  {
    quote: "Un superbe livre que j'ai adoré lire, je l'ai même lu 2 fois. Une superbe personne vraiment, raconté avec humour, ce livre je l'ai trouvé très apaisant et très bien expliqué.",
    author: "Agnès J. · Amazon"
  },
  {
    quote: "Merci à l'autrice pour ce livre, qui m'a offert deux lectures en une. La première est une découverte : n'ayant jamais rien lu sur l'autisme, j'ai apprécié d'y entrer par le quotidien et des scènes vécues plutôt que par un traité médical. La seconde s'est faite malgré moi, en écho à mon métier d’expert dans l’accompagnement des transformations et situations sociales complexes.",
    author: "Xavier T. · Amazon"
  },
  {
    quote: "J'ai le coeur serré à lire votre livre car je me dis Ouf Quel soulagement de ne pas etre seule à ressentir cela.",
    author: "Morgane · Instagram"
  }
];

/*
 * Les références de presse ci-dessous sont volontairement limitées aux mentions
 * vérifiables. D'autres articles peuvent être ajoutés au fur et à mesure des parutions.
 */
const pressReferences = [
  {
    name: "Tribune de Genève",
    logo: "tdg",
    description: "Mention de Réjane Salaün et de Mon infini est bleu par la Tribune de Genève.",
    url: "https://x.com/tdgch/status/2089315053170278870"
  },
  {
    name: "24 heures",
    logo: "24h",
    description: "Autisme : les femmes de plus en plus nombreuses à être diagnostiquées.",
    url: "https://www.24heures.ch/autisme-les-femmes-de-plus-en-plus-nombreuses-a-etre-diagnostiquees-589932415024"
  },
  {
    name: "Femina",
    logo: "femina",
    description: "Article consacré au parcours de Réjane Salaün et à son témoignage autour de l'autisme au féminin.",
    url: ""
  }
];

const pressCitations = pressReferences
  .filter((reference) => reference.url)
  .map((reference) => ({
    "@type": "CreativeWork",
    "name": reference.description,
    "url": reference.url,
    "publisher": {
      "@type": "Organization",
      "name": reference.name
    }
  }));

const bookJsonLd = {
  "@context": "https://schema.org",
  "@type": "Book",
  "@id": `${canonical}#book`,
  "name": "Mon infini est bleu",
  "author": {
    "@type": "Person",
    "name": "Réjane Salaün"
  },
  "description": description,
  "inLanguage": "fr-FR",
  "genre": ["Essai", "Récit", "Témoignage"],
  "keywords": [
    "Mon infini est bleu",
    "Réjane Salaün",
    "autisme au féminin",
    "diversité cognitive",
    "neurodiversité",
    "témoignage autisme",
    "livre sur l'autisme"
  ],
  "about": [
    { "@type": "Thing", "name": "Autisme au féminin" },
    { "@type": "Thing", "name": "Diversité cognitive" },
    { "@type": "Thing", "name": "Neurodiversité" }
  ],
  "image": coverImage,
  "isbn": "979-8185716458",
  "numberOfPages": 140,
  "bookFormat": "https://schema.org/Paperback",
  "datePublished": "2026-07-02",
  "url": canonical,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonical
  }
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": canonical,
  "url": canonical,
  "name": title,
  "description": description,
  "inLanguage": "fr-FR",
  "mainEntity": { "@id": `${canonical}#book` }
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "We-TheAgency",
      "item": "https://www.we-theagency.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Magazine",
      "item": "https://www.we-theagency.com/magazine"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Mon infini est bleu",
      "item": canonical
