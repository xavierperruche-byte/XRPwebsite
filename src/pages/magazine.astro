<style>

 /* Hero Sections - Style Elementor */
  .hero-section-first,
  .hero-section-second {
    width: 100%;
    padding: 0;
    margin: 0;
  }

  .hero-container {
    width: 100%;
    max-width: 100%;
    padding-left: 2rem;
    padding-right: 2rem;
    margin: 0 auto;
  }

  .hero-title-second {
    font-family: var(--font-main);
    font-size: 25px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 4px;
    color: #000;
    margin: 0;
    padding: 1.5rem 0;
    text-align: center;
  }

  .hero-title-first {
    font-family: var(--font-main);
    font-size: 35px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 5px;
    color: #000;
    margin: 0;
    padding: 1.5rem 0;
    text-align: center;
  }

  /* Divider */
  .divider-line {
    width: 100%;
    height: 1px;
    background: #000;
    margin: 2rem 0;
  }
  
  /* Spacer pour éviter que le contenu soit caché sous les navs */
  .spacer-top {
    height: 130px; /* Header (80px) + Subnav (60px) + marge (40px) */
  }

/* Navigation secondaire flottante - Style identique au header */
.floating-subnav {
  position: fixed;
  top: 10px;
  left: 2%;
  width: auto;
  max-width: 200px;
  z-index: 9999;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 20px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  overflow: hidden;
}

.floating-subnav:hover {
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55);
  transform: translateX(-2%) translateY(-2px);
}

  .subnav-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    align-items: flex-start; /* Aligne le contenu à gauche (mieux pour un menu vertical) */
    justify-content: center;
    padding: 0.1rem 0.2rem;
    gap: 0.1rem;
  }

/* Masque tous les liens par défaut */
.subnav-link {
  /* Style de base... */
  opacity: 0;
  max-height: 0;
  padding: 5; /* Important : supprime le padding pour le masquer */
  margin: 0;
  visibility: hidden;
  transition: opacity 0.3s, max-height 0.3s, padding 0.3s, margin 0.3s, transform 0.3s ease;
}

/* Affiche UNIQUEMENT le lien actif */
.subnav-link.active {
  opacity: 1;
  max-height: 50px; /* Une hauteur suffisante pour le lien */
  padding: 0.75rem 1.25rem; /* Rétablit le padding du lien actif */
  margin: 0.5rem 0.5rem; /* Ajoute un petit espace vertical */
  visibility: visible;
  /* Styles de couleur actifs (conservés) */
  background: linear-gradient(45deg, #857f74, #000000);
  color: white;
  box-shadow: 0 3px 5px rgba(102, 126, 234, 0.1);
}


/* 🚀 NOUVEAU : Affiche TOUS les liens au survol du conteneur parent */
.floating-subnav:hover .subnav-link {
  opacity: 1;
  max-height: 50px; /* Hauteur maximale pour le déploiement */
  padding: 0.75rem 1.25rem; /* Rétablit le padding pour tous les liens */
  margin: 0.1rem 0;
  visibility: visible;
  /* Le lien actif garde ses styles de couleur spécifiques */
}

/* Règle de survol pour les liens NON actifs */
.floating-subnav:hover .subnav-link:not(.active):hover {
  background: rgba(171, 171, 171, 0.3); /* Effet de survol sur les autres liens */
  color: #000000;
  transform: translateY(-2px);
}

  .subnav-link:hover {
    background: rgba(171, 171, 171, 0.3);
    color: #000000;
    transform: translateY(-2px);
  }

  .subnav-link.active {
    background: linear-gradient(45deg, #857f74, #000000);
    color: white;
    border-radius: 20px;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.1);
  }

  .subnav-link .nav-icon {
    margin-right: 0.5rem;
    font-size: 0.8rem;
  }

  .subnav-link .nav-text {
    font-weight: 200;
    font-size: 0.8rem;
  }

  /* Scroll Effect pour la subnav */
  .floating-subnav.scrolled {
    background: rgba(255, 255, 255, 0.5);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
  }


  /* Responsive */
  @media (max-width: 1024px) {
    .floating-subnav {
      top: 90px;
      width: 90%;
    }

    .subnav-container {
      padding: 0.5rem 1rem;
      gap: 0.25rem;
    }

    .subnav-link {
      padding: 0.6rem 1rem;
    }

    .subnav-link .nav-text {
      font-size: 0.9rem;
    }

    .hero-container {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .spacer-top {
      height: 160px;
    }

    .floating-subnav {
      top: 90px;
      max-width: 180px;
    }
    .subnav-container {
      padding: 0.0rem 0.0rem;
      gap: 0.00rem;
    }

    .subnav-link {
      padding: 0.0rem 0.0rem;
    }

    .subnav-link .nav-text {
      font-size: 0.9rem;
    }

    .hero-title-first {
      font-size: 20px;
      padding: 1rem 0;
    }

    .hero-title-second {
      font-size: 18px;
      padding: 1rem 0;
    }

    .hero-container {
      padding-left: 1rem;
      padding-right: 1rem;
    }

   .content-section {
      padding: 2rem 0 4rem 0;
    }
  }

  
@media (max-width: 480px) {
  .spacer-top {
    height: 140px;
  }

  .hero-title-first {
    font-size: 18px;
  }

  .hero-title-second {
    font-size: 16px;
  }

  .hero-container {
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }

  .text-content {
    font-size: 13px;
  }
}

/* --- Modale PDF Responsive --- */
.pdf-modal {
    display: none; /* Masqué par défaut */
    position: fixed;
    z-index: 10000; /* Assurez-vous qu'elle est au-dessus de tout */
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.9); /* Fond noir semi-transparent */
}

.pdf-modal.open {
    display: block;
}

.pdf-modal-content {
    background-color: #fefefe;
    margin: 1% auto; /* Centrage vertical et horizontal */
    padding: 20px;
    border: 1px solid #888;
    width: 95%; /* Largeur de la modale sur ordinateur */
    height: 95%; /* Hauteur pour que l'iframe soit grand */
    position: relative;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.5);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
}

#pdfTitle {
    margin-top: 0;
    margin-bottom: 10px;
    text-align: center;
    font-size: 1.2rem;
    color: #333;
}

#pdfIframe {
    flex-grow: 1; /* L'iframe prend tout l'espace restant dans la modale */
    border: none;
}

/* Bouton Fermer */
.pdf-close-btn {
    color: #aaa;
    position: absolute;
    top: 10px;
    right: 25px;
    font-size: 40px;
    font-weight: bold;
    cursor: pointer;
    line-height: 20px;
    transition: 0.3s;
}

.pdf-close-btn:hover,
.pdf-close-btn:focus {
    color: #000;
}

/* Responsive pour les petits écrans */
@media (max-width: 768px) {
    .pdf-modal-content {
        width: 95%; /* Modale plus large sur mobile */
        height: 95%; 
        margin: 2.5% auto;
    }
}

/* ============================================
   BOOK SECTION — Split éditorial asymétrique
   ============================================ */

.book-section {
  --book-overlap: clamp(6rem, 6vw, 4.5rem); /* Chevauchement du bloc texte sur l'image */
  --book-ink: #14141a;
  --book-ink-soft: #5a5a64;
  --book-hairline: #e3e1dc;
  width: 100%;
  padding: clamp(3rem, 8vw, 6rem) 0;
  margin: 0;
  background: #faf9f6;
  overflow: hidden;
}

.book-eyebrow {
  max-width: 1024px;
  margin: 0 auto;
  padding: 0 clamp(1.5rem, 5vw, 3rem);
  font-family: 'Urbanist', sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--book-ink-soft);
  margin-bottom: 1.5rem;
}

.book-eyebrow::before {
  content: '';
  display: inline-block;
  width: 28px;
  height: 1px;
  background: var(--book-ink-soft);
  margin-right: 0.75rem;
  vertical-align: middle;
}

.book-container {
  position: relative;
  max-width: 1024px;
  margin: 0 auto;
  padding: 0 clamp(1.5rem, 5vw, 3rem);
  display: grid;
  grid-template-columns: 1fr;
}

.book-illustration {
  position: relative;
  width: 100%;
  max-width: clamp(220px, 70vw, 480px); /* Réduit fluidement sur petit écran */
  margin: 0 auto; /* Centre l'image quand elle est plus petite que le container */
  border-radius: 6px;
  overflow: hidden;
  aspect-ratio: 4 / 5;
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
}

.book-illustration.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.book-illustration img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.book-illustration:hover {
      transform: translateY(-5px); /* Léger effet 3D */
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.40);
}

.book-container:hover {
  transform: scale(1.00);
}

.book-text {
  position: relative;
  background: #ffffff;
  margin-top: calc(-1 * var(--book-overlap));
  margin-right: clamp(0px, 4vw, 2.5rem);
  margin-left: clamp(1rem, 6vw, 3.5rem);
  padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.75rem, 5vw, 3rem);
  box-shadow: 0 24px 60px -20px rgba(20, 20, 26, 0.18);
  border: 1px solid var(--book-hairline);
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s, box-shadow 0.4s ease;
}

.book-text.is-visible {
  opacity: 0.95;
  transform: translateY(-20px);
}

.book-container:hover .book-text {
  box-shadow: 0 28px 70px -18px rgba(20, 20, 26, 0.24);
}

.book-kicker {
  display: block;
  font-family: 'Urbanist', sans-serif;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--book-ink-soft);
  margin-bottom: 0.85rem;
}

.book-text h3 {
  font-family: 'Libre Bodoni', serif;
  font-size: clamp(1.6rem, 3.2vw, 2.3rem);
  font-weight: 600;
  line-height: 1.15;
  color: var(--book-ink);
  margin: 0 0 0.6rem 0;
  letter-spacing: -0.01em;
}

.book-author {
  font-size: 0.95rem;
  color: var(--book-ink-soft);
  margin: 0 0 1.5rem 0;
  font-style: italic;
}

.book-buy {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--book-hairline);
}

.book-buy-link {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.6rem 1.1rem;
  border: 1px solid var(--book-ink);
  border-radius: 999px;
  font-family: 'Urbanist', sans-serif;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--book-ink);
  text-decoration: none;
  transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
}

.book-buy-link svg {
  transition: transform 0.25s ease;
}

.book-buy-link:hover {
  background: var(--book-ink);
  color: #ffffff;
  transform: translateY(-2px);
}

.book-buy-link:hover svg {
  transform: translate(2px, -2px);
}

/* ---- Desktop : split asymétrique avec chevauchement ---- */
@media (min-width: 768px) {
  .book-container {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
  }

  .book-illustration {
    aspect-ratio: 3 / 4;
    grid-column: 1;
    grid-row: 1;
    max-width: none; /* L'image reprend toute la largeur de sa colonne grid */
    margin: 0;
  }

  .book-text {
    grid-column: 2;
    grid-row: 1;
    margin-top: 0;
    margin-left: calc(-1 * var(--book-overlap)); /* Chevauche le bord droit de l'image */
    margin-right: 0;
    max-width: 420px;
    z-index: 2;
  }
}

@media (min-width: 1100px) {
  .book-text {
    padding: 3rem 3.25rem;
  }
}

/* ---- Bloc détail : Extrait + Bio ---- */
.book-detail {
  max-width: 1240px;
  margin: clamp(3rem, 7vw, 5rem) auto 0;
  padding: 0 clamp(1.5rem, 5vw, 3rem);
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.5rem;
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
}

.book-detail.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.book-detail-label {
  display: block;
  font-family: 'Urbanist', sans-serif;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--book-ink-soft);
  margin-bottom: 1.1rem;
}

.book-detail-extract blockquote {
  margin: 0;
  font-family: 'Libre Bodoni', serif;
  font-size: clamp(1.05rem, 1.6vw, 1.3rem);
  line-height: 1.55;
  font-style: italic;
  color: var(--book-ink);
  padding-left: 1.25rem;
  border-left: 2px solid var(--book-ink);
}

.book-detail-bio p {
  margin: 0;
  font-family: 'Urbanist', sans-serif;
  font-size: 1rem;
  letter-spacing: 1px;
  line-height: 1.7;
  color: var(--book-ink-soft);
}

.book-detail-bio p em {
  color: var(--book-ink);
  font-style: italic;
}

.book-detail-divider {
  display: none;
}

@media (min-width: 900px) {
  .book-detail {
    grid-template-columns: 1.1fr auto 1fr;
    align-items: start;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .book-detail-divider {
    display: block;
    width: 1px;
    height: 100%;
    background: var(--book-hairline);
  }
}

/* Respecte les préférences de mouvement réduit */
@media (prefers-reduced-motion: reduce) {
  .book-illustration,
  .book-text,
  .book-detail {
    transition: none;
    opacity: 1;
    transform: none;
  }
  .book-container:hover .book-illustration img {
    transform: none;
  }
}

/* ============================================
   MODAL BROCHÉ
   ============================================ */

.broche-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.broche-modal[hidden] {
  display: none;
}

.broche-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(20, 20, 26, 0.55);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  opacity: 0;
  transition: opacity 0.35s ease;
}

.broche-modal.is-open .broche-modal-backdrop {
  opacity: 1;
}

.broche-modal-panel {
  position: relative;
  z-index: 1;
  background: #ffffff;
  border: 1px solid #e3e1dc;
  border-radius: 4px;
  padding: clamp(2rem, 5vw, 3rem) clamp(2rem, 5vw, 3.5rem);
  width: min(480px, calc(100vw - 3rem));
  box-shadow: 0 32px 80px -20px rgba(20, 20, 26, 0.28);
  opacity: 0;
  transform: translateY(18px) scale(0.98);
  transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.broche-modal.is-open .broche-modal-panel {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.broche-modal-close {
  position: absolute;
  top: 1.1rem;
  right: 1.1rem;
  background: none;
  border: none;
  padding: 0.4rem;
  cursor: pointer;
  color: #5a5a64;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s, color 0.2s;
}

.broche-modal-close:hover {
  background: #f0eeeb;
  color: #14141a;
}

.broche-modal-kicker {
  display: block;
  font-family: 'Urbanist', sans-serif;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #5a5a64;
  margin-bottom: 0.75rem;
}

.broche-modal-panel h4 {
  font-family: 'Libre Bodoni', serif;
  font-size: clamp(1.4rem, 3vw, 1.8rem);
  font-weight: 600;
  color: #14141a;
  margin: 0 0 0.6rem;
  line-height: 1.2;
}

.broche-modal-sub {
  font-family: 'Urbanist', sans-serif;
  font-size: 0.97rem;
  line-height: 1.65;
  color: #5a5a64;
  margin: 0;
}

/* Liste de liens distributeurs (optionnelle) */
.broche-modal-links {
  list-style: none;
  padding: 0;
  margin: 1.5rem 0 0;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.broche-modal-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.85rem 1.1rem;
  border: 1px solid #e3e1dc;
  border-radius: 4px;
  font-family: 'Urbanist', sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
  color: #14141a;
  text-decoration: none;
  transition: background 0.2s, border-color 0.2s, transform 0.2s;
}

.broche-modal-link:hover {
  background: #14141a;
  border-color: #14141a;
  color: #ffffff;
  transform: translateX(3px);
}

.broche-modal-link svg {
  flex-shrink: 0;
  transition: transform 0.2s;
}

.broche-modal-link:hover svg {
  transform: translate(2px, -2px);
}
</style>

<script>
  // Reveal au scroll pour la section book (fade + translate)
  document.addEventListener('DOMContentLoaded', () => {
    const bookIllustration = document.querySelector('.book-illustration');
    const bookText = document.querySelector('.book-text');
    const bookDetail = document.querySelector('.book-detail');

    if (!bookIllustration || !bookText) return;

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );

    revealObserver.observe(bookIllustration);
    revealObserver.observe(bookText);
    if (bookDetail) revealObserver.observe(bookDetail);

    // ── Modal Broché ──────────────────────────────────────────
    const modal    = document.getElementById('broche-modal');
    const btnOpen  = document.getElementById('btn-broche');
    const btnClose = document.getElementById('broche-modal-close');

    function openModal() {
      if (!modal) return;
      modal.hidden = false;
      requestAnimationFrame(() => modal.classList.add('is-open'));
      document.body.style.overflow = 'hidden';
      btnClose?.focus();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
      setTimeout(() => { modal.hidden = true; }, 350);
      btnOpen?.focus();
    }

    btnOpen?.addEventListener('click', openModal);
    btnClose?.addEventListener('click', closeModal);

    // Ferme sur clic backdrop
    modal?.querySelector('.broche-modal-backdrop')?.addEventListener('click', closeModal);

    // Ferme sur Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
    });
  });
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const sections = document.querySelectorAll('section[id]');
  const subnavLinks = document.querySelectorAll('.subnav-link');

  // Fonction pour mettre à jour le lien actif
  function updateActiveLink() {
    let currentSection = '';
    const scrollPosition = window.scrollY + 200; // Offset pour déclencher plus tôt

    sections.forEach(section => {
      const sectionTop = section.offsetTop;
      const sectionHeight = section.offsetHeight;
      
      if (scrollPosition >= sectionTop && scrollPosition < sectionTop + sectionHeight) {
        currentSection = section.getAttribute('id');
      }
    });

    // Mettre à jour les liens actifs
    subnavLinks.forEach(link => {
      link.classList.remove('active');
      if (link.getAttribute('href') === `#${currentSection}`) {
        link.classList.add('active');
      }
    });
  }

  // Écouter le scroll
  window.addEventListener('scroll', updateActiveLink);
  
  // Écouter les clics sur les liens pour une navigation smooth
  subnavLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.getAttribute('href').substring(1);
      const targetSection = document.getElementById(targetId);
      
      if (targetSection) {
        const offsetTop = targetSection.offsetTop - 150; // Ajuster l'offset selon vos besoins
        window.scrollTo({
          top: offsetTop,
          behavior: 'smooth'
        });
        
        // Mettre à jour immédiatement le lien actif
        subnavLinks.forEach(l => l.classList.remove('active'));
        link.classList.add('active');
      }
    });
  });

  // Appeler une première fois au chargement
  updateActiveLink();
});

// Fonctions de gestion de la modale PDF
  window.openPdfViewer = function(pdfUrl, title) {
    if (!pdfUrl) return;

    const modal = document.getElementById('pdfViewerModal');
    const iframe = document.getElementById('pdfIframe');
    const pdfTitle = document.getElementById('pdfTitle');

// Construction des paramètres d'URL
    let finalUrl = pdfUrl;
    
 // Détecter la taille de l'écran pour le mode responsive (mobile)
    const isMobile = window.matchMedia("only screen and (max-width: 768px)").matches;

    if (!isMobile) {
      // ✅ Mode Double Page avec Page de Garde (pour Desktop)
      // view=TwoPageRight: Force la mise en page double page.
      // L'effet "page de garde séparée" est obtenu car la page 1 n'a pas de page à sa gauche.
      finalUrl += '#pagemode=ShowCoverPageDuringTwoUp&pageLayout=TwoColumnRight&page=1'; 
    } else {
      // Mode Page Simple pour Mobile (plus facile à lire)
      finalUrl += '#toolbar=0&view=Fit';
    }

    iframe.src = pdfUrl; 
    pdfTitle.textContent = title;
    
    modal.classList.add('open');
    document.body.style.overflow = 'hidden'; 
  }

  window.closePdfViewer = function() {
    const modal = document.getElementById('pdfViewerModal');
    const iframe = document.getElementById('pdfIframe');
    
    modal.classList.remove('open');
    iframe.src = '';
    document.body.style.overflow = 'auto';
  }
  
  // Fermer si l'utilisateur clique en dehors de la modale
  const modal = document.getElementById('pdfViewerModal');
  if (modal) {
      window.addEventListener('click', (event) => {
          if (event.target === modal) {
              window.closePdfViewer();
          }
      });
  }

</script>