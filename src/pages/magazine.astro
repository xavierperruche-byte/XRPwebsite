    </div>
  <div class="book-eyebrow">À paraître</div>
  <div class="book-container">
    <figure class="book-illustration">
      <img src="/images/MonInfiniEstBleu.webp" alt="Mon infini est bleu">
    </figure>
    <div class="book-text">
      <span class="book-kicker">Essai</span>
      <h3>Mon infini est bleu</h3>
      <p class="book-author">Réjane Salaün</p>
      <div class="book-buy">
        <a href="https://www.amazon.fr/Mon-infini-bleu-R%C3%A9jane-Sala%C3%BCn-ebook/dp/B0H49NMJW1/ref=sr_1_1?__mk_fr_FR=%C3%85M%C3%85%C5%BD%C3%95%C3%91&crid=1YDTF7GJPS5J0&dib=eyJ2IjoiMSJ9.0vHEa-zlm_dBTC-OGguzTA.sy3fFDNZjV9Zavr4Rk9uDS3qUOtM2RzMgdKCEkX_aEs&dib_tag=se&keywords=rejane+salaun&qid=1781727188&sprefix=rejane+salaun%2Caps%2C149&sr=8-1" target="_blank" class="book-buy-link">
          <span>Kindle</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17" stroke-linecap="round" stroke-linejoin="round"/></svg>
