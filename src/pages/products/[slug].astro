    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .reviewer-info strong {
    color: #2d3748;
  }

  .review-date {
    font-size: 0.85rem;
    color: #a0aec0;
  }

  .review-stars {
    color: #f6ad55;
  }

  .review-card p {
    color: #4a5568;
    line-height: 1.6;
  }

  /* Related products */
  .related-products {
    margin-top: 4rem;
  }

  .related-products h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    text-align: center;
    color: #2d3748;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .product-card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s;
  }

  .product-card:hover {
    transform: translateY(-5px);
  }

  .card-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-card h3 {
    padding: 1rem 1.5rem 0.5rem;
    color: #2d3748;
  }

  .card-price {
    padding: 0 1.5rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: #686f8d;
  }

  .card-link {
    display: block;
    padding: 1rem 1.5rem;
