<script>
  // Infinite loop testimonials slider with 2 per view
  const slider = document.getElementById('testimonialsSlider');
  const wrapper = document.getElementById('testimonialsWrapper');
  const prevBtn = document.querySelector('.nav-prev');
  const nextBtn = document.querySelector('.nav-next');
  
  if (!slider) throw new Error('Slider not found');
  
  // Configuration
  const totalOriginalItems = 3; // Your testimonials count
  let currentIndex = 1; // Start at 1 (after the cloned last item)
  let itemsPerView = window.innerWidth > 1024 ? 2 : 1;
  let isTransitioning = false;
  let autoPlayInterval: number;
  
  // Touch/Mouse drag variables
  let isDragging = false;
  let startPos = 0;
  let currentTranslate = 0;
  let prevTranslate = 0;
  let animationID: number;
  
  function getItemWidth() {
    return 100 / itemsPerView;
  }
  
  function updateSlider(instant = false) {
    if (!slider) return;

       const itemWidth = getItemWidth();
       const offset = -currentIndex * itemWidth;
    
    if (instant) {
      slider.style.transition = 'none';
    } else {
      slider.style.transition = 'transform 0.5s ease-in-out';
    }
    
    slider.style.transform = `translateX(${offset}%)`;
    
    if (instant) {
      // Force reflow
      void slider.offsetHeight;
    }
  }

  function nextSlide() {
    if (isTransitioning) return;
    
    isTransitioning = true;
    currentIndex++;
    updateSlider(false);
    
    // Check if we've reached the cloned first item
    setTimeout(() => {
      if (currentIndex === totalOriginalItems + 1) {
        currentIndex = 1;
        updateSlider(true);
      }
      isTransitioning = false;
    }, 500);
  }
  
  function prevSlide() {
    if (isTransitioning) return;
    
    isTransitioning = true;
    
    if (currentIndex === 1) {
      // Jump to the cloned last item
      currentIndex = totalOriginalItems + 1;
      updateSlider(true);
      
      setTimeout(() => {
        currentIndex = totalOriginalItems;
        updateSlider(false);
        setTimeout(() => {
          isTransitioning = false;
        }, 500);
      }, 50);
    } else {
      currentIndex--;
      updateSlider(false);
      setTimeout(() => {
        isTransitioning = false;
      }, 500);
    }
  }
  
  // Auto-advance after 10s
  function startAutoPlay() {
    stopAutoPlay(); // Clear any existing interval
    autoPlayInterval = setInterval(() => {
      nextSlide();
    }, 10000);
  }
  
  function stopAutoPlay() {
    if (autoPlayInterval) {
      clearInterval(autoPlayInterval);
    }
  }
  
  // Navigation buttons
  if (prevBtn && nextBtn) {
    prevBtn.addEventListener('click', () => {
      prevSlide();
      stopAutoPlay();
      startAutoPlay();
    });
    
    nextBtn.addEventListener('click', () => {
      nextSlide();
      stopAutoPlay();
      startAutoPlay();
    });
  }
  
  // Touch/Mouse drag support
  function touchStart(index: number) {
    return function(event: TouchEvent | MouseEvent) {
      isDragging = true;
      startPos = getPositionX(event);
      animationID = requestAnimationFrame(animation);
      
      if (wrapper) {
        wrapper.style.cursor = 'grabbing';
      }
      
      stopAutoPlay();
    };
  }
  
  function touchMove(event: TouchEvent | MouseEvent) {
    if (isDragging) {
      const currentPosition = getPositionX(event);
      currentTranslate = prevTranslate + currentPosition - startPos;
    }
  }
  
  function touchEnd() {
    isDragging = false;
    cancelAnimationFrame(animationID);
    
    if (wrapper) {
      wrapper.style.cursor = 'grab';
    }
    
    const movedBy = currentTranslate - prevTranslate;
    
    // If moved enough, go to next/prev slide
    if (movedBy < -50) {
      nextSlide();
    } else if (movedBy > 50) {
      prevSlide();
    } else {
      updateSlider(false);
    }
    
    currentTranslate = 0;
    prevTranslate = 0;
    
    startAutoPlay();
  }
  
  function getPositionX(event: TouchEvent | MouseEvent) {
    return event.type.includes('mouse') 
      ? (event as MouseEvent).pageX 
      : (event as TouchEvent).touches[0].clientX;
  }
  
  function animation() {
    if (slider && isDragging) {
      const itemWidth = getItemWidth();
      const baseOffset = -currentIndex * itemWidth;
      const dragOffset = (currentTranslate / window.innerWidth) * 100;
      slider.style.transform = `translateX(${baseOffset + dragOffset}%)`;
      requestAnimationFrame(animation);
    }
  }
  
  // Add event listeners
  if (wrapper) {
    // Mouse events
    wrapper.addEventListener('mousedown', touchStart(0));
    wrapper.addEventListener('mousemove', touchMove);
    wrapper.addEventListener('mouseup', touchEnd);
    wrapper.addEventListener('mouseleave', () => {
      if (isDragging) {
        touchEnd();
      }
    });
    
    // Touch events
    wrapper.addEventListener('touchstart', touchStart(0), { passive: true });
    wrapper.addEventListener('touchmove', touchMove, { passive: true });
    wrapper.addEventListener('touchend', touchEnd);
    
    // Pause on hover (desktop only)
    if (window.innerWidth > 1024) {
      wrapper.addEventListener('mouseenter', stopAutoPlay);
      wrapper.addEventListener('mouseleave', startAutoPlay);
    }
  }
  
  // Handle window resize
  window.addEventListener('resize', () => {
    const newItemsPerView = window.innerWidth > 1024 ? 2 : 1;
    if (newItemsPerView !== itemsPerView) {
      itemsPerView = newItemsPerView;
      updateSlider(true);
    }
  });

  // Initialize
  updateSlider(true);
  startAutoPlay();

  // ========================================
  // HERO SLIDER SCRIPT - AJOUTÉ ICI !
  // ========================================
  
  const heroSlides = document.querySelectorAll('.hero-slider .slide');
  const heroIndicators = document.querySelectorAll('.hero-slider .indicator');
  const heroPrevBtn = document.querySelector('.hero-slider .slider-nav.prev');
  const heroNextBtn = document.querySelector('.hero-slider .slider-nav.next');
  
  let heroCurrentSlide = 0;
  let heroAutoPlayInterval;
  
  function showHeroSlide(index) {
    // Remove active class from all slides and indicators
    heroSlides.forEach(slide => slide.classList.remove('active'));
    heroIndicators.forEach(indicator => indicator.classList.remove('active'));
    
    // Add active class to current slide and indicator
    if (heroSlides[index]) {
      heroSlides[index].classList.add('active');
    }
    if (heroIndicators[index]) {
      heroIndicators[index].classList.add('active');
    }
    
    heroCurrentSlide = index;
  }
  
  function nextHeroSlide() {
    let nextIndex = (heroCurrentSlide + 1) % heroSlides.length;
    showHeroSlide(nextIndex);
  }
  
  function prevHeroSlide() {
    let prevIndex = (heroCurrentSlide - 1 + heroSlides.length) % heroSlides.length;
    showHeroSlide(prevIndex);
  }
  
  function startHeroAutoPlay() {
    stopHeroAutoPlay();
    heroAutoPlayInterval = setInterval(nextHeroSlide, 2500); // Change slide every 3 seconds
  }
  
  function stopHeroAutoPlay() {
    if (heroAutoPlayInterval) {
      clearInterval(heroAutoPlayInterval);
    }
  }
  
  // Event listeners for hero slider
  if (heroPrevBtn) {
    heroPrevBtn.addEventListener('click', () => {
      prevHeroSlide();
      stopHeroAutoPlay();
      startHeroAutoPlay();
    });
  }
  
  if (heroNextBtn) {
    heroNextBtn.addEventListener('click', () => {
      nextHeroSlide();
      stopHeroAutoPlay();
      startHeroAutoPlay();
    });
  }
  
  // Indicator clicks for hero
  heroIndicators.forEach((indicator, index) => {
    indicator.addEventListener('click', () => {
      showHeroSlide(index);
      stopHeroAutoPlay();
      startHeroAutoPlay();
    });
  });
  
  // Keyboard navigation for hero
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      prevHeroSlide();
      stopHeroAutoPlay();
      startHeroAutoPlay();
    } else if (e.key === 'ArrowRight') {
      nextHeroSlide();
      stopHeroAutoPlay();
      startHeroAutoPlay();
    }
  });
  
  // Initialize hero slider
  startHeroAutoPlay();
  
  // Pause on hover
  const heroSlider = document.querySelector('.hero-slider');
  if (heroSlider) {
    heroSlider.addEventListener('mouseenter', stopHeroAutoPlay);
    heroSlider.addEventListener('mouseleave', startHeroAutoPlay);
  }
</script>