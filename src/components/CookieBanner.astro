<div id="cookie-banner" class="cookie-banner-hidden" role="dialog" aria-live="polite" aria-label="Gestion des cookies">
  <div class="cookie-container">
    <div class="cookie-text">
      <p>
        <strong>IA Dispatch</strong> utilise des cookies pour améliorer votre expérience et mesurer l'audience (Mailchimp et Google Analytics). En poursuivant votre navigation, vous acceptez notre politique de confidentialité.
      </p>
    </div>
    <div class="cookie-buttons">
      <button id="cookie-accept" class="cookie-btn cookie-btn-primary">Accepter</button>
      <button id="cookie-refuse" class="cookie-btn cookie-btn-secondary">Refuser</button>
    </div>
  </div>
</div>

<script>
  // On récupère la clé publique définie dans votre fichier .env
  const RECAPTCHA_SITE_KEY = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;

  function setCookie(name, value, days) {
    const date = new Date();
    date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
    const expires = "; expires=" + date.toUTCString();
    document.cookie = name + "=" + (value || "") + expires + "; path=/; SameSite=Lax";
  }

  function getCookie(name) {
    const nameEQ = name + "=";
    const ca = document.cookie.split(';');
    for (let i = 0; i < ca.length; i++) {
      let c = ca[i];
      while (c.charAt(0) === ' ') c = c.substring(1, c.length);
      if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
    }
    return null;
  }

  function deleteCookie(name) {
    document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
  }

  function loadGoogleTagManager() {
    const script = document.createElement('script');
    script.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-N2B3VHRS';
    script.async = true;
    document.head.appendChild(script);

    window.dataLayer = window.dataLayer || [];
    function gtm(){dataLayer.push(arguments);}
    gtm('js', new Date());
    gtm('config', 'GTM-N2B3VHRS');
  }

  // --- CHARGEMENT DYNAMIQUE DE RECAPTCHA ---
  function loadReCaptcha() {
    if (typeof grecaptcha !== 'undefined' || !RECAPTCHA_SITE_KEY) return;
    const script = document.createElement('script');
    script.src = `https://www.google.com/recaptcha/api.js?render=${RECAPTCHA_SITE_KEY}`;
    script.async = true;
    script.defer = true;
    document.head.appendChild(script);
  }

  // --- VÉRIFICATION SÉCURISÉE (CAPTCHA + NEVERBOUNCE) ---
  async function verifyEmailAndCaptcha(email, recaptchaToken) {
    try {
      const response = await fetch('/verify.php', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        // CORRECTION DE LA COQUILLE : JSON doit être en MAJUSCULES
        body: JSON.stringify({ 
          email: email,
          recaptcha_token: recaptchaToken 
        })
      });

      if (!response.ok) return true; 

      const data = await response.json();
      return data.isValid === true;
    } catch (error) {
      console.error('Erreur de validation serveur:', error);
      return true; // Fallback local de sécurité pour ne pas bloquer l'abonné si le réseau flanche
    }
  }

  // --- COMPORTEMENT DU BANDEAU DE COOKIES ---
  function initCookieBanner() {
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');
    const refuseBtn = document.getElementById('cookie-refuse');

    if (!banner) return;

    if (!getCookie('cookie_consent_accepted')) {
      banner.classList.remove('cookie-banner-hidden');
    } else if (getCookie('cookie_consent_accepted') === 'true') {
      loadGoogleTagManager();
      // Charger reCAPTCHA si l'utilisateur a déjà consenti
      loadReCaptcha();
    }

    acceptBtn?.addEventListener('click', () => {
      setCookie('cookie_consent_accepted', 'true', 395);
      banner.classList.add('cookie-banner-hidden');
      loadGoogleTagManager(); 
      // Charger reCAPTCHA seulement après consentement explicite
      loadReCaptcha();
    });

    refuseBtn?.addEventListener('click', () => {
      setCookie('cookie_consent_accepted', 'false', 395);
      banner.classList.add('cookie-banner-hidden');
      deleteCookie('_ga');
      deleteCookie('_ga_VC8JVK2D5C');
    });
  }

  // --- INTERCEPTION DU FORMULAIRE NEWSLETTER (DÉLÉGATION GLOBALE) ---
  document.addEventListener('submit', async (e) => {
    const newsletterForm = e.target;

    // On intercepte uniquement le formulaire de l'étoile
    if (!(newsletterForm instanceof HTMLFormElement) || newsletterForm.id !== 'newsletter-form') return;

    e.preventDefault(); // On bloque l'envoi immédiat pour faire les vérifications
    
    const emailInput = document.getElementById('mce-EMAIL');
    const triggerZone = document.getElementById('newsletter-trigger');
    const starContainer = document.getElementById('newsletter-star');
    const targetButton = e.submitter;
    
    if (!emailInput) {
      HTMLFormElement.prototype.submit.call(newsletterForm);
      return;
    }

    const email = emailInput.value;
    
      if (targetButton instanceof HTMLButtonElement) {
        targetButton.disabled = true; 
        targetButton.style.opacity = '0.5';
      }

    try {
      let token = '';
      if (typeof grecaptcha !== 'undefined' && RECAPTCHA_SITE_KEY) {
        token = await new Promise((resolve) => {
          const timeout = setTimeout(() => resolve(''), 2000); // Sécurité anti-gel
          grecaptcha.ready(async () => {
            try {
              const t = await grecaptcha.execute(RECAPTCHA_SITE_KEY, { action: 'subscribe' });
              clearTimeout(timeout);
              resolve(t);
            } catch (err) {
              clearTimeout(timeout);
              resolve('');
            }
          });
        });
      }

      // --- FALLBACK: si reCAPTCHA indisponible ou token vide, exiger une preuve humaine simple ---
      const recaptchaBlocked = (typeof grecaptcha === 'undefined' && RECAPTCHA_SITE_KEY);
      if (recaptchaBlocked || token === '') {
        // injecter un contrôle de type checkbox si absent
        let humanCheck = newsletterForm.querySelector('#human-check');
        if (!humanCheck) {
          const wrapper = document.createElement('div');
          wrapper.className = 'human-check-wrapper';
          wrapper.style.marginTop = '8px';
          wrapper.innerHTML = `
            <label style="display:flex;align-items:center;gap:8px;font-size:0.95rem;color:#222;">
              <input type="checkbox" id="human-check" style="width:18px;height:18px;" />
              Je confirme que je suis humain
            </label>
            <div id="human-check-msg" style="color:#c00;font-size:0.9rem;margin-top:6px;display:none;">Veuillez cocher la case pour prouver que vous êtes humain.</div>
          `;
          // insert after email input
          if (emailInput && emailInput.parentNode) {
            emailInput.parentNode.insertBefore(wrapper, emailInput.nextSibling);
          }
          humanCheck = newsletterForm.querySelector('#human-check');
        }

        const checkbox = newsletterForm.querySelector('#human-check');
        const msg = newsletterForm.querySelector('#human-check-msg');

        if (!(checkbox instanceof HTMLInputElement) || !checkbox.checked) {
          if (msg) msg.style.display = 'block';
          if (targetButton instanceof HTMLButtonElement) {
            targetButton.disabled = false;
            targetButton.style.opacity = '1';
          }
          return; // Stopper l'envoi tant que la preuve humaine n'est pas fournie
        }
      }

      // 1. Exécution de votre double vérification reCAPTCHA + NeverBounce
      const isValid = await verifyEmailAndCaptcha(email, token);
      
      if (isValid) {
        console.log("Validation réussie ! Déclenchement des animations et envoi...");
        
        // 2. On applique les animations visuelles sur l'étoile
        if (triggerZone) {
          triggerZone.innerHTML = '<span class="star-title">MERCI !</span><span class="star-subtitle"><br/>Bienvenue à bord.</span>';
        }
        
        // Cookie d'interaction pour ne plus afficher l'étoile
        document.cookie = "newsletter_interacted=true; max-age=" + (60 * 24 * 60 * 60) + "; path=/; SameSite=Lax";

        // Désactivation légère après envoi pour éviter les conflits d'iframe
        setTimeout(() => { if (emailInput) emailInput.disabled = true; }, 50);

        // Fermeture de l'étoile animée
        setTimeout(() => {
          starContainer?.classList.remove('is-active');
        }, 1000);

        // 3. ENVOI RÉEL À MAILCHIMP
        HTMLFormElement.prototype.submit.call(newsletterForm);
        
      } else {
        alert('La validation a échoué. Si vous êtes un humain, veuillez vérifier votre saisie.');
        if (targetButton instanceof HTMLButtonElement) {
          targetButton.disabled = false;
          targetButton.style.opacity = '1';
        }
      }
    } catch (err) {
      console.error('Erreur critique processus, envoi forcé :', err);
      HTMLFormElement.prototype.submit.call(newsletterForm);
    }
  });

  // Initialisation globale
  window.addEventListener('DOMContentLoaded', () => {
    initCookieBanner(); 
    // reCAPTCHA est chargé uniquement après consentement explicite via le bandeau
  });
</script>

<style>
  #cookie-banner {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 32px);
    max-width: 600px;
    background: #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    border-radius: 16px;
    z-index: 999999;
    padding: 16px 20px;
    box-sizing: border-box;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.3s ease;
    opacity: 1;
  }

  #cookie-banner.cookie-banner-hidden {
    transform: translate(-50%, 100px);
    opacity: 0;
    pointer-events: none;
  }

  .cookie-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
  }

  @media (min-width: 520px) {
    .cookie-container {
      flex-direction: row;
      justify-content: space-between;
      gap: 24px;
    }
  }

  .cookie-text p {
    margin: 0;
    color: #ffffff;
    font-family: 'Urbanist', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 13px;
    line-height: 1.5;
  }

  .cookie-text strong {
    color: #ACFA39;
    font-weight: 700;
  }

  .cookie-buttons {
    display: flex;
    gap: 10px;
    width: 100%;
    justify-content: flex-end;
    flex-shrink: 0;
  }

  @media (min-width: 520px) {
    .cookie-buttons {
      width: auto;
    }
  }

  .cookie-btn {
    font-family: 'Urbanist', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 13px;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 30px;
    cursor: pointer;
    border: none;
    outline: none;
    transition: transform 0.2s ease, background-color 0.2s ease;
    width: 100%;
    text-align: center;
  }

  @media (min-width: 520px) {
    .cookie-btn {
      width: auto;
    }
  }

  .cookie-btn:hover {
    transform: scale(1.03);
  }

  .cookie-btn-primary {
    background: #ACFA39;
    color: #1a1a1a;
  }

  .cookie-btn-primary:hover {
    background: #ffffff;
  }

  .cookie-btn-secondary {
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .cookie-btn-secondary:hover {
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
  }
</style>