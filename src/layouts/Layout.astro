---
// src/layouts/Layout.astro - Main layout wrapper
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
  ogImage?: string;
  keywords?: string;
}

const { 
  title = 'We-TheAgency - Créativité Stratégique, Tech sur Mesure | Genève, Paris, Singapour', 
  description = 'We-TheAgency : Agence de création d\'identité visuelle, webdesign et développement commercial à Genève, Paris et Singapour. Expertise en branding, marketing digital et solutions tech sur mesure. Business with Attitude.',
  currentPage = '',
  ogImage = 'https://www.we-theagency.com/images/og-image.jpg',
  keywords = 'agence communication Genève, identité visuelle, webdesign, développement commercial, marketing digital, branding Suisse, création site web, agence créative, tech sur mesure'
} = Astro.props;

// URL canonique
const canonicalURL = new URL(Astro.request.url);
