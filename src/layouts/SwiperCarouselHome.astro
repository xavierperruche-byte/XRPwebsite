<script>
if (typeof window !== 'undefined') {
  document.addEventListener('DOMContentLoaded', function () {
    try {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const slide = entry.target;
            const vid = slide.querySelector('video');
            if (vid && vid.dataset) {
              // Create <source> elements for WebM and MP4 if provided
              const webm = vid.dataset.srcWebm || vid.dataset.srcWebm;
              const mp4 = vid.dataset.srcMp4 || vid.dataset.srcMp4 || vid.dataset.src;
              // Only add sources if none exist
              if (vid.querySelectorAll('source').length === 0) {
                if (webm) {
                  const s1 = document.createElement('source');
                  s1.src = webm;
                  s1.type = 'video/webm';
                  vid.appendChild(s1);
                }
                if (mp4) {
                  const s2 = document.createElement('source');
                  s2.src = mp4;
                  s2.type = 'video/mp4';
                  vid.appendChild(s2);
                }
                // Trigger loading but do not autoplay; leave the browser to defer playback
                if (vid.load) vid.load();
              }
            }
            io.unobserve(slide);
          }
        });
      }, { rootMargin: '300px' });

      document.querySelectorAll('.slide-video').forEach((el) => io.observe(el));
    } catch (e) {
      // graceful fallback
      console.warn('Video lazy-load observer failed', e);
    }
  });
}
</script>

<script>
  import { register } from 'swiper/element/bundle';
  
  // Enregistre Swiper Element côté client
  register();

  // Configuration responsive via JavaScript après initialisation
  document.addEventListener('DOMContentLoaded', () => {
    const swiperEl = document.querySelector('.mySwiper');
    const prevBtn = document.querySelector('.custom-prev');
    const nextBtn = document.querySelector('.custom-next');
    const overlay = document.getElementById('imageOverlay');
    const overlayImage = document.getElementById('overlayImage');
    const overlayVideo = document.getElementById('overlayVideo');
    const overlayTitle = document.getElementById('overlayTitle');
    const overlayDescription = document.getElementById('overlayDescription');
    const overlayDetails = document.getElementById('overlayDetails');
    const closeBtn = document.getElementById('closeOverlay');
    
    // Keep carousel videos lazy: do NOT preload or autoplay here.
    // When a video slide is intersected the observer will add sources and call load().
    const videoSlides = document.querySelectorAll('.slide-video');
    videoSlides.forEach(slide => {
      const video = slide.querySelector('video');
      if (video) {
        // Ensure preload remains 'none' until explicitly needed
        video.preload = 'none';
        // Keep loop handler for when the video eventually plays (overlay or user interaction)
        video.addEventListener('timeupdate', function() {
          if (this.duration && this.duration - this.currentTime < 0.1) {
            this.currentTime = 0;
          }
        });
      }
    });
    

    if (swiperEl) {
      // Gestion des boutons de navigation personnalisés
      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          swiperEl.swiper.slidePrev();
        });
      }
      
      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          swiperEl.swiper.slideNext();
        });
      }

      // Gestion du clic UNIQUEMENT sur les slides du carousel avec la classe 'carousel-slide-content'
      const carouselSlideContents = document.querySelectorAll('.carousel-slide-content');
      carouselSlideContents.forEach(content => {
        content.addEventListener('click', () => {
          const imageSrc = content.getAttribute('data-image');
          const videoSrc = content.getAttribute('data-video');
          const title = content.getAttribute('data-title');
          const description = content.getAttribute('data-description');
          const details = content.getAttribute('data-details');
          
          if (overlay) {
            if (overlayTitle) overlayTitle.textContent = title || '';
            if (overlayDescription) overlayDescription.textContent = description || '';
            if (overlayDetails) overlayDetails.innerHTML = details || '<p>Aucun détail supplémentaire disponible.</p>';

                        
            // Si c'est une vidéo
            if (videoSrc && overlayVideo) {
              overlayImage.style.display = 'none';
              overlayVideo.style.display = 'block';
              // Prefer WebM if available
              const parent = content;
              const webm = parent.getAttribute('data-video-webm');
              const mp4 = parent.getAttribute('data-video') || parent.getAttribute('data-video-mp4');
              // Remove existing sources
              while (overlayVideo.firstChild) overlayVideo.removeChild(overlayVideo.firstChild);
              if (webm) {
                const s1 = document.createElement('source');
                s1.src = webm;
                s1.type = 'video/webm';
                overlayVideo.appendChild(s1);
              }
              if (mp4) {
                const s2 = document.createElement('source');
                s2.src = mp4;
                s2.type = 'video/mp4';
                overlayVideo.appendChild(s2);
              }
              overlayVideo.loop = true;
              overlayVideo.muted = true;
              overlayVideo.preload = 'auto';
              overlayVideo.load();
              
              // Méthode alternative pour boucle fluide
              overlayVideo.addEventListener('timeupdate', function() {
                if (this.duration && this.duration - this.currentTime < 0.1) {
                  this.currentTime = 0;
                }
              });
              
              const playPromise = overlayVideo.play();
              if (playPromise !== undefined) {
                playPromise.catch(e => console.log('Video play error:', e));
              }
            } 
            // Si c'est une image
            else if (imageSrc && overlayImage) {
              overlayVideo.style.display = 'none';
              overlayImage.style.display = 'block';
              overlayImage.src = imageSrc;
            }
            
            overlay.classList.add('active');
          }
        });
      });

      // Fermer l'overlay
      if (closeBtn && overlay) {
        closeBtn.addEventListener('click', () => {
          overlay.classList.remove('active');
          if (overlayVideo) {
            overlayVideo.pause();
            overlayVideo.currentTime = 0;
          }

        });
        
        // Fermer en cliquant sur le fond
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) {
            overlay.classList.remove('active');
            if (overlayVideo) {
              overlayVideo.pause();
              overlayVideo.currentTime = 0;
            }

          }
        });
      }

      // Fermer avec la touche Echap
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && overlay) {
          overlay.classList.remove('active');
          if (overlayVideo) {
            overlayVideo.pause();
            overlayVideo.currentTime = 0;
          }

        }
      });

      const updateSlidesPerView = () => {
        const width = window.innerWidth;
        
        if (width < 640) {
          swiperEl.setAttribute('slides-per-view', '1');
          swiperEl.setAttribute('space-between', '10');
        } else if (width < 1024) {
          swiperEl.setAttribute('slides-per-view', '2');
          swiperEl.setAttribute('space-between', '15');
        } else if (width < 1834) {
          swiperEl.setAttribute('slides-per-view', '3');
          swiperEl.setAttribute('space-between', '20');
        } else {
          swiperEl.setAttribute('slides-per-view', '4');
          swiperEl.setAttribute('space-between', '20');
        }
      };
      
      updateSlidesPerView();
      window.addEventListener('resize', updateSlidesPerView);
    }
  });
</script>